<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/css/styles.css" rel="stylesheet" />

    <!-- Incluye el CSS de Flatpickr -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css"
    />

    <title>Formulario - Poder Judicial</title>
  </head>

  <body class="text-lg bg-gray-100 flex flex-col items-center min-h-screen">
    <!-- Encabezado -->
    <header
      class="w-full bg-verdegris shadow-md flex justify-center items-center sticky"
    >
      <img src="/images/pj-logo.png" alt="Logo" class="mr-24 w-24 h-auto" />
      <label class="text-xl md:text-2xl font-bold text-white"
        >Poder Judicial del Estado de Hidalgo</label
      >
    </header>

    <!-- Títulos -->
    <div class="mt-16 text-center">
      <h1 class="text-3xl font-bold text-indigo-950 mb-2">
        Alta de trabajador
      </h1>
      <p class="text-slate-500 max-w-xl mx-auto">
        Por favor revisa e ingresa los datos del trabajador en el formulario.
        Revisa muy bien que los datos sean correctos. Ingresa todos los datos
        como se indica
      </p>
    </div>

    <!-- Formulario -->
    <form
      action="/insert"
      method="POST"
      class="mt-8 mb-14 bg-white p-8 rounded-3xl shadow-md max-w-xl w-full flex flex-col gap-4"
    >
      <h2 class="text-xl font-bold text-indigo-950 mb-2">Insertar datos</h2>
      <p class="text-slate-500 mb-4">
        Por favor revisa e ingresa la información en los campos correspondientes
      </p>

      <div>
        <label class="block mb-1 font-medium text-indigo-950"
          >Tipo de Trabajador</label
        >
        <div class="flex gap-6 mt-2">
          <label class="flex items-center gap-2 cursor-pointer">
            <input
              type="radio"
              name="tipoTrabajador"
              value="C"
              required
              class="w-4 h-4"
              style="accent-color: #738f81"
            />
            <span>Confianza</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input
              type="radio"
              name="tipoTrabajador"
              value="H"
              required
              class="w-4 h-4"
              style="accent-color: #738f81"
            />
            <span>Honorario</span>
          </label>
        </div>
      </div>

      <div>
        <label class="block mb-1 font-medium text-indigo-950"
          >No. de Trabajador</label
        >
        <input
          type="number"
          name="noTrabajador"
          class="border w-full p-3 rounded-full bg-gray-50"
          placeholder="No. de trabajador"
          required
        />
      </div>

      <!-- Nombre -->
      <div>
        <label class="block mb-1 font-medium text-indigo-950"
          >Nombre Completo</label
        >
        <input
          type="text"
          class="border w-full p-3 rounded-full bg-gray-50"
          name="nombre"
          placeholder="NOMBRE (MAYUSCULAS) EMPEZANDO POR APELLIDOS"
          required
        />
      </div>

      <div>
        <label class="block mb-1 font-medium text-indigo-950">CURP</label>
        <input
          type="text"
          class="border w-full p-3 rounded-full bg-gray-50"
          name="curp"
          placeholder="CURP"
          required
        />
      </div>

      <div>
        <label class="block mb-1 font-medium text-indigo-950">RFC</label>
        <input
          type="text"
          class="border w-full p-3 rounded-full bg-gray-50"
          name="rfc"
          placeholder="RFC con homoclave (todo junto sin guiones)"
          required
        />
      </div>

      <!-- Apellido Paterno -->
      <!--  
    <div>
      <label class="block mb-1 font-medium text-indigo-950">Apellido Paterno</label>
      <input type="text" class="border w-full p-3 rounded-full bg-gray-50" placeholder="Apellido Paterno" required>
    </div>

     Apellido Materno
    <div>
      <label class="block mb-1 font-medium text-indigo-950">Apellido Materno</label>
      <input type="text" class="border w-full p-3 rounded-full bg-gray-50" placeholder="Apellido Materno" required>
    </div>

    -->

      <!-- Botón -->
      <button
        type="submit"
        id="botonFormulario"
        class="mt-6 bg-gradient-to-b from-lime-500 to-verdegris text-white py-3 rounded-full text-xl font-bold hover:opacity-90"
      >
        Siguiente
      </button>
    </form>

    <!-- Inputmask -->
    <script src="https://cdn.jsdelivr.net/npm/inputmask@5.0.8/dist/inputmask.min.js"></script>

    <!-- Flatpickr -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <!-- Mi JS -->
    <!--<script src="/js/formulario.js"></script>-->
  </body>
</html>
