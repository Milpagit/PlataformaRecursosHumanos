<!DOCTYPE html>
<html lang="es">

  <head>
    <meta charset="UTF-8">
    <title>Acuse de Registro</title>
    <link href="/css/styles.css" rel="stylesheet">
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      @media print {
        .noprint {
          display: none !important;
        }
        
        * {
          margin: 0;
          padding: 0;
        }

        body {
          background: white !important;
          padding: 0.5in !important;
          margin: 0 !important;
        }

        .acuse-container {
          max-width: 100%;
          margin: 0 !important;
          padding: 0 !important;
          box-shadow: none !important;
          border: none !important;
          background: white !important;
        }

        h1, h2 {
          page-break-after: avoid;
          orphans: 3;
          widows: 3;
        }

        ul, ol {
          orphans: 2;
          widows: 2;
        }

        li {
          orphans: 2;
          widows: 2;
          line-height: 1.6;
        }

        img {
          max-width: 100%;
        }

        .flex {
          display: flex !important;
        }

        .justify-center {
          justify-content: center !important;
        }

        .items-center {
          align-items: center !important;
        }
      }

      body {
        background-color: #f3f4f6;
        padding: 20px;
      }

      .acuse-container {
        max-width: 900px;
        margin: 0 auto;
        background-color: white;
        padding: 30px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      }

      h2 {
        margin-top: 25px;
        margin-bottom: 12px;
        font-size: 1.3rem;
        font-weight: bold;
        color: #1a202c;
        page-break-after: avoid;
      }

      ul {
        list-style-position: outside;
        padding-left: 20px;
        margin-bottom: 15px;
      }

      li {
        margin-bottom: 8px;
        line-height: 1.6;
        word-wrap: break-word;
      }

      p {
        line-height: 1.6;
        margin-bottom: 10px;
      }

      .encabezado-pj {
        line-height: 1.1;
      }

      .encabezado-pj p {
        margin-bottom: 2px;
        line-height: 1.1;
      }
    </style>
  </head>

  <body class="bg-gray-100 text-gray-900 p-6">
    <div id="acuseContent" class="acuse-container">

      <div class="flex justify-center items-center mb-6">
        <img src="/images/pj-logo-verde.png" alt="Logo" class="h-28 w-24 mr-4">
        <div class="encabezado-pj" aling="text-center">
          <p class="text-center font-bold text-grisTexto tracking-normal">Poder Judicial del Estado de Hidalgo</p>
          <p class="text-center font-bold text-grisTexto tracking-normal">Consejo de la Judicatura </p>
          <p class="text-center font-bold text-grisTexto tracking-normal">Comisión de Administración</p>
          <p class="text-center font-bold text-grisTexto tracking-normal">Coordinación General de Administración</p>
          <p class="text-center font-bold text-grisTexto tracking-normal">Dirección de Recursos Humanos</p>
        </div>
        <img src="/images/consejo-logo-verde.png" alt="Logo" class="h-20 ml-4">
      </div>

      <h1 class="text-4xl font-extrabold text-center text-gray-800 mb-8 underline">ACUSE</h1>

      <p class="text-center mb-8 text-gray-700">
        Este documento certifica que el siguiente trabajador ha completado correctamente el registro y actualización de
        datos en la plataforma del Poder Judicial del Estado de Hidalgo.
      </p>

      <h2>Datos del Trabajador</h2>
      <ul class="list-disc pl-6">
        <li><strong>No. de Trabajador:</strong>
          <%= trabajador.noTrabajador %>
        </li>
        <li><strong>Nombre Completo:</strong>
          <%= trabajador.nombreTrabajador %>
        </li>
        <li><strong>RFC:</strong>
          <%= trabajador.rfc %>
        </li>
        <li><strong>CURP:</strong>
          <%= trabajador.curp %>
        </li>
        <li><strong>Fecha de Ingreso:</strong>
          <%= formatearFecha(trabajador.fechaIngreso) %>
        </li>
        <li><strong>Adscripción Actual:</strong>
          <%= trabajador.adscripcionActual %>
        </li>
        <li><strong>Cargo Actual:</strong>
          <%= trabajador.cargoActual %>
        </li>
        <li><strong>Sexo:</strong>
          <%= trabajador.sexoTrabajador %>
        </li>
        <li><strong>Fecha de Nacimiento:</strong>
          <%= formatearFecha(trabajador.fechaNacimiento) %>
        </li>
        <li><strong>Lugar de Nacimiento:</strong>
          <%= trabajador.lugarNacimiento %>
        </li>
        <li><strong>Estado Civil:</strong>
          <%= trabajador.estadoCivil %>
        </li>
        <li><strong>Nombre del Cónyuge:</strong>
          <%= trabajador.nombreConyuge %>
        </li>
        <li><strong>Fecha de Nacimiento del Cónyuge:</strong>
          <%= formatearFecha(trabajador.fechaNacimientoConyuge) %>
        </li>
        <li><strong>Sexo del Cónyuge:</strong>
          <%= trabajador.sexoConyuge %>
        </li>
        <li><strong>Tipo de Sangre:</strong>
          <%= trabajador.tipoSangre %>
        </li>
        <li><strong>Vigencia INE:</strong>
          <%= trabajador.vigenciaINE %>
        </li>
        <li><strong>Correo Electrónico:</strong>
          <%= trabajador.correoElectronico %>
        </li>
        <li><strong>Teléfono Celular:</strong>
          <%= trabajador.noTelefono %>
        </li>
        <li><strong>Teléfono de Casa:</strong>
          <%= trabajador.telefonoCasa %>
        </li>
        <li><strong>Teléfono Familiar:</strong>
          <%= trabajador.telefonoFamiliar %> (<%= trabajador.parentescoFamiliar %>)
        </li>
        <li><strong>Domicilio INE:</strong>
          <%= trabajador.calleNumero %>, <%= trabajador.colonia %>, <%= trabajador.municipio %>, <%= trabajador.estado
                  %>, CP: <%= trabajador.codigoPostal %>
        </li>
        <li><strong>Domicilio Actual:</strong>
          <%= trabajador.actualCalleNumero %>, <%= trabajador.actualColonia %>, <%= trabajador.actualMunicipio %>, <%=
                  trabajador.actualEstado %>, CP: <%= trabajador.actualCP %>
        </li>
        <li><strong>Comunidad Indígena:</strong>
          <%= trabajador.comunidadIndigena %>
        </li>
        <li><strong>Familia Lingüística:</strong>
          <%= trabajador.familiaLinguistica %>
        </li>
        <li><strong>Tipo de Discapacidad:</strong>
          <%= trabajador.tipoDiscapacidad %>
        </li>
        <li><strong>Discapacidad Especificada:</strong>
          <%= trabajador.discapacidadEspecificada %>
        </li>
        <li><strong>Lenguaje de Señas:</strong>
          <%= trabajador.lenguajeSenias %> (Dominio: <%= trabajador.dominioLSM %>)
        </li>
        <li><strong>¿Tiene enfermedad crónica?:</strong>
          <%= trabajador.tieneEnfermedadCronica %>
        </li>
        <li><strong>Tipo de Enfermedad:</strong>
          <%= trabajador.tipoCronica %>
        </li>
        <li><strong>¿Es padre o madre?:</strong>
          <%= trabajador.es_padre_madre %>
        </li>
        <li><strong>¿Está embarazada?:</strong>
          <%= trabajador.embarazada %>
        </li>
        <li><strong>Cantidad de Hijos:</strong>
          <%= trabajador.cantidadHijos %>
        </li>
      </ul>

      <% if (hijos && hijos.length > 0) { %>
        <h2>Hijos</h2>
        <ul class="list-disc pl-6">
          <% hijos.forEach(h => { %>
            <li>
              <%= h.inicialesHijo %> — <%= h.sexoHijo %> — <%= formatearFecha(h.fechaNacimientoHijo) %> — <%= h.edadHijo %> años
            </li>
          <% }) %>
        </ul>
      <% } %>

      <% if (escolaridad && escolaridad.length > 0) { %>
        <h2>Escolaridad</h2>
        <ul class="list-disc pl-6">
          <% escolaridad.forEach(e => { %>
            <li>
              <strong><%= e.nivelAcademico || e.NivelAcademico %>:</strong> 
              
              <%= e.nombreTitulo || e.NombreTitulo || 'Sin Título' %> — 
              
              <% 
                let fechaMostrar = 'Sin Fecha';
                // Obtenemos el valor crudo
                let fechaRaw = e.fechaObtencion || e.FechaObtencion;
                
                if (fechaRaw) {
                    // Convertir a string si es un objeto Date u otro tipo
                    let fechaStr = typeof fechaRaw === 'string' ? fechaRaw : String(fechaRaw);
                    
                    // Si es un texto tipo "2024-10-17", intentamos formatearlo
                    if (fechaStr.includes('-')) {
                      // Tu helper formatearFecha
                      fechaMostrar = formatearFecha(fechaRaw); 
                    } else {
                      // Si es texto raro ("MAYO 03"), lo mostramos tal cual para no romper nada
                      fechaMostrar = fechaStr;
                    }
                }
              %>
              <%= fechaMostrar %> — 

              <%= e.institucion || e.Institucion || 'Sin Institución' %> — 
              
              <%= e.estatus || e.Estatus %> — 
              
              Documento: <%= e.documentoAdquirido || e.DocumentoAdquirido || 'N/A' %> — 
              Cédula: <%= e.cedulaProfesional || e.CedulaProfesional || 'S/N' %>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <% if (actualizacion && actualizacion.length > 0) { %>
        <h2>Actualizaciones Profesionales</h2>
        <ul class="list-disc pl-6">
          <% actualizacion.forEach(a => { %>
            <li>
              <%= a.tema %> — <%= a.institucion %> — <%= formatearFecha(a.fecha) %> — Documento: <%= a.documento %>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <% if (experienciaPJ && experienciaPJ.length > 0) { %>
        <h2>Experiencia Laboral</h2>
        <ul class="list-disc pl-6">
          <% experienciaPJ.forEach(p => { %>
            <li>
              <%= p.cargo %> — <%= p.institucion %> — <%= p.adscripcion %> — <%= p.campoExperiencia %> — Inicio: <%= p.periodoInicio %> — Fin: <%= p.periodoFin %>
            </li>
          <% }) %>
        </ul>
      <% } %>

                <p class="text-center mt-8 text-gray-700 text-center"><span class="text-red-500">
                  He leído y acepto el aviso de privacidad de la Plataforma de Actualización de Datos Personales del Personal del Poder Judicial del Estado de Hidalgo</span>
                </p>

                  <div class="mt-16 text-center">
                    <p class="text-gray-700">_______________________________________</p>
                    <p class="text-gray-800 font-bold">
                      <%= trabajador.nombreTrabajador %>
                    </p>
                    <p class="text-gray-600 text-sm italic">Firma del trabajador</p>
                  </div>

                  <p class="text-center mt-8 text-gray-700 text-center">
                    Entregar en el área de Recursos Humanos del Poder Judicial del Estado de Hidalgo
                  </p>
    </div>

    <div class="text-center mt-10 noprint">
      <button onclick="imprimirAcuse()"
        class="noprint bg-blue-600 text-white px-6 py-3 rounded hover:bg-blue-700">Imprimir</button>
      <button onclick="descargarPDF()"
        class="noprint bg-blue-600 text-white px-6 py-3 rounded hover:bg-blue-700">Descargar</button>

    </div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>



<script>
  async function descargarPDF() {
    const { jsPDF } = window.jspdf;

    // Ocultar botones de impresión/descarga
    const elementos = document.querySelectorAll('.noprint');
    const estilosOriginales = [];
    elementos.forEach(el => {
      estilosOriginales.push(el.style.display);
      el.style.display = 'none';
    });

    await new Promise(resolve => setTimeout(resolve, 100));

    const elemento = document.getElementById("acuseContent");
    
    // Capturar con resolución más alta para mejor calidad
    const canvas = await html2canvas(elemento, {
      scale: 3,
      useCORS: true,
      logging: false,
      allowTaint: true,
      backgroundColor: '#ffffff'
    });

    // Configurar PDF con márgenes estándar
    const pdf = new jsPDF({
      orientation: 'p',
      unit: 'pt',
      format: 'letter' // 8.5" x 11" = 612pt x 792pt
    });

    const pageWidth = pdf.internal.pageSize.getWidth();
    const pageHeight = pdf.internal.pageSize.getHeight();
    
    // Márgenes en puntos (0.5 pulgadas = 36 puntos)
    const marginLeft = 36;
    const marginRight = 36;
    const marginTop = 36;
    const marginBottom = 36;
    
    const usableWidth = pageWidth - marginLeft - marginRight;
    const usableHeight = pageHeight - marginTop - marginBottom;

    // Calcular dimensiones de la imagen
    const imgWidth = canvas.width;
    const imgHeight = canvas.height;
    
    // Escalar imagen para ajustarse al ancho usable
    const ratio = usableWidth / imgWidth;
    const scaledHeight = imgHeight * ratio;

    let yPosition = marginTop;
    let pageNum = 1;
    const totalHeight = scaledHeight;
    let remainingHeight = scaledHeight;

    // Procesar página por página
    while (remainingHeight > 0) {
      // Crear un canvas temporal para la sección actual de la página
      const tempCanvas = document.createElement('canvas');
      const sourceHeight = Math.min(usableHeight / ratio, imgHeight - (totalHeight - remainingHeight) / ratio);
      
      tempCanvas.width = imgWidth;
      tempCanvas.height = sourceHeight;

      const ctx = tempCanvas.getContext('2d');
      ctx.drawImage(
        canvas,
        0,
        (totalHeight - remainingHeight) / ratio,
        imgWidth,
        sourceHeight,
        0,
        0,
        imgWidth,
        sourceHeight
      );

      const pageImage = tempCanvas.toDataURL('image/jpeg', 0.95);
      
      if (pageNum > 1) {
        pdf.addPage();
      }
      
      pdf.addImage(
        pageImage,
        'JPEG',
        marginLeft,
        marginTop,
        usableWidth,
        sourceHeight * ratio
      );

      remainingHeight -= usableHeight;
      pageNum++;
    }

    // Restaurar estilos originales
    elementos.forEach((el, i) => {
      el.style.display = estilosOriginales[i];
    });

    // Descargar el PDF
    pdf.save(`acuse_${new Date().getTime()}.pdf`);
  }

  function imprimirAcuse() {
    // Ocultar botones
    const elementos = document.querySelectorAll('.noprint');
    const estilosOriginales = [];
    
    elementos.forEach(el => {
      estilosOriginales.push(el.style.display);
      el.style.display = 'none';
    });

    // Esperar a que se renderice
    setTimeout(() => {
      // Usar window.print()
      window.print();
      
      // Restaurar estilos después de la impresión
      setTimeout(() => {
        elementos.forEach((el, i) => {
          el.style.display = estilosOriginales[i];
        });
      }, 100);
    }, 100);
  }
</script>


</body>

</html>