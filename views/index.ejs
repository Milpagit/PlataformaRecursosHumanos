        <!-- ¿Perteneces a comunidad indígena? -->
        <div class="mb-3">
          <label class="block mb-1 font-bold text-gray-700">
            ¿Perteneces a una comunidad o pueblo indígena?
          </label>
          <div class="flex gap-4">
            <% 
              // Lógica principal: inferir Sí/No mirando comunidadIndigena
              const valComunidad = user.comunidadIndigena ? user.comunidadIndigena.trim().toUpperCase() : 'N/A';
              const tieneComunidad = (valComunidad !== 'N/A' && valComunidad !== '');

              const esIndigena = tieneComunidad ? '1' : '0';
            %>

            <label class="flex items-center cursor-pointer">
              <input
                type="radio"
                name="indigena"
                value="1"
                class="mr-2"
                <%= esIndigena === '1' ? 'checked' : '' %>
                required
                data-toggle="comunidad-indigena"
              />
              Sí
            </label>

            <label class="flex items-center cursor-pointer">
              <input
                type="radio"
                name="indigena"
                value="0"
                class="mr-2"
                <%= esIndigena === '0' ? 'checked' : '' %>
                data-toggle="comunidad-indigena"
              />
              No
            </label>
          </div>
        </div>

        <!-- Contenedor de comunidad indígena -->
        <div id="comunidadIndigenaContainer" class="<%= esIndigena === '1' ? '' : 'hidden' %> mb-3">
          <label class="block mb-1 font-bold text-gray-700">
            Selecciona tu comunidad o pueblo indígena
          </label>
          <!-- Contenedor de comunidad indígena (se muestra si es "Sí") -->
        <select
          class="border border-gray-300 w-full p-3 rounded-md bg-gray-50"
          id="comunidadIndigena"
          name="comunidadIndigena"
          <%= esIndigena === '1' ? 'required' : '' %>
          <% 
            // Array completo con TODAS las opciones en MAYÚSCULAS y SIN ACENTOS
            const opcionesComunidad = [
              { value: "", texto: "SELECCIONA UNA OPCION" },
              { value: "CHINANTECO", texto: "CHINANTECO" },
              { value: "CH'OL", texto: "CH'OL" },
              { value: "CORA", texto: "CORA" },
              { value: "HUASTECO", texto: "HUASTECO" },
              { value: "HUICHOL", texto: "HUICHOL" },
              { value: "MAYA", texto: "MAYA" },
              { value: "MAYO", texto: "MAYO" },
              { value: "MAZAHUA", texto: "MAZAHUA" },
              { value: "MAZATECO", texto: "MAZATECO" },
              { value: "MIXE", texto: "MIXE" },
              { value: "MIXTECO", texto: "MIXTECO" },
              { value: "NAHUATL", texto: "NAHUATL" },
              { value: "OTOMI", texto: "OTOMI" },
              { value: "TARASCO / PUREPECHA", texto: "TARASCO / PUREPECHA" },
              { value: "TARAHUMARA", texto: "TARAHUMARA" },
              { value: "TEPEHUANO", texto: "TEPEHUANO" },
              { value: "TLAPANECO", texto: "TLAPANECO" },
              { value: "TOTONACO", texto: "TOTONACO" },
              { value: "TSELTAL", texto: "TSELTAL" },
              { value: "TSOTSIL", texto: "TSOTSIL" },
              { value: "YAQUI", texto: "YAQUI" },
              { value: "ZAPOTECO", texto: "ZAPOTECO" },
              { value: "ZOQUE", texto: "ZOQUE" },
              { value: "PUEBLO INDIGENA NO IDENTIFICADO", texto: "PUEBLO INDIGENA NO IDENTIFICADO" },
              { value: "OTRO", texto: "OTRO PUEBLO INDIGENA (ESPECIFIQUE)" }
            ];

            // Valor actual normalizado (mayúsculas y sin acentos)
            const comunidadActual = user.comunidadIndigena 
              ? user.comunidadIndigena.trim().toUpperCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "") 
              : '';
          %>

          <% 
            // Generamos todas las opciones con el loop
            opcionesComunidad.forEach(opcion => { 
          %>
            <option 
              value="<%= opcion.value %>" 
              <%= comunidadActual === opcion.value ? 'selected' : '' %>
            >
              <%= opcion.texto %>
            </option>
          <% }); %>
        </select>

        <!-- Campo adicional para "OTRO" -->
        <div id="otraComunidadContainer" class="<%= comunidadActual === 'OTRO' ? '' : 'hidden' %> mt-3">
          <label class="block mb-1 font-bold text-gray-700">
            Especifica tu comunidad o pueblo indígena
          </label>
          <input
            type="text"
            name="otraComunidad"
            value="<%= user.otraComunidad && user.otraComunidad.toUpperCase() !== 'N/A' ? user.otraComunidad.trim() : '' %>"
            class="border border-gray-300 w-full p-3 rounded-md bg-gray-50 uppercase"
          />
        </div>
      </div>
        <!-- ¿Hablas una lengua indígena? -->
        <div class="mb-3">
          <label class="block mb-1 font-bold text-gray-700"
            >¿Hablas alguna lengua indígena?</label
          >
          <div class="flex gap-4">
            <% 
              // CORRECCIÓN: Usar familiaLinguistica que es el campo real de la BD
              const valFamilia = user.familiaLinguistica ? user.familiaLinguistica.trim().toUpperCase() : 'N/A';
              const lenguaIndigena = (valFamilia !== 'N/A' && valFamilia !== '');

              const leIndigena = lenguaIndigena ? '1' : '0';
            %>
            <label
              ><input
                type="radio"
                name="hablaLenguaIndigena"
                value="1"
                class="mr-2"
                <%= leIndigena === '1' ? 'checked' : '' %>
                required
                data-toggle="lengua-indigena"
              />
              Sí</label
            >
            <label
              ><input
                type="radio"
                name="hablaLenguaIndigena"
                value="0"
                class="mr-2"
                <%= leIndigena === '0' ? 'checked' : '' %>
                data-toggle="lengua-indigena"
              />
              No</label
            >
          </div>
        </div>

        <!-- Selector de familia lingüística -->
        <div id="familiaLingContainer" class="<%= leIndigena === '1' ? '' : 'hidden' %> mb-3">
          <label class="block mb-1 font-bold text-gray-700"
            >Selecciona la familia lingüística</label
          >
          <% 
            const opcionesFamilia = [
              { value: "", texto: "Selecciona una opción" },
              { value: "HOKANA", texto: "HOKANA" },
              { value: "CHINANTECA", texto: "CHINANTECA" },
              { value: "OTOPAME", texto: "OTOPAME" },
              { value: "OAXAQUEÑA", texto: "OAXAQUEÑA" },
              { value: "HUAVE", texto: "HUAVE" },
              { value: "TLAPANECA", texto: "TLAPANECA" },
              { value: "TOTONACA", texto: "TOTONACA" },
              { value: "MIXE-ZOQUE", texto: "MIXE-ZOQUE" },
              { value: "MAYA", texto: "MAYA" },
              { value: "YUTOAZTECA", texto: "YUTOAZTECA" },
              { value: "TARASCA", texto: "TARASCA" },
              { value: "ALGONQUINA", texto: "ALGONQUINA" },
              { value: "FAMILIA LINGÜÍSTICA NO IDENTIFICADA", texto: "FAMILIA LINGÜÍSTICA NO IDENTIFICADA" },
              { value: "OTRA", texto: "OTRA FAMILIA LINGÜÍSTICA (ESPECIFIQUE)" }
            ];

            let familiaSeleccionada = "";
            let otraFamiliaTexto = "";

            if (leIndigena === '1') {
               const encontrada = opcionesFamilia.find(op => op.value === valFamilia);
               if (encontrada) {
                 familiaSeleccionada = valFamilia;
               } else if (valFamilia !== 'N/A' && valFamilia !== '') {
                 familiaSeleccionada = "OTRA";
                 otraFamiliaTexto = valFamilia;
               }
            }
          %>
          <select
            name="familiaLinguistica"
            class="border border-gray-300 w-full p-3 rounded-md bg-gray-50"
            id="familiaLinguistica"
            <%= leIndigena === '1' ? 'required' : '' %>
          >
            <% opcionesFamilia.forEach(op => { %>
              <option value="<%= op.value %>" <%= familiaSeleccionada === op.value ? 'selected' : '' %>>
                <%= op.texto %>
              </option>
            <% }) %>
          </select>
        </div>

        <div id="otraLenguaContainer" class="<%= familiaSeleccionada === 'OTRA' ? '' : 'hidden' %> mt-2 mb-4">
          <label class="block text-gray-700"
            >Especifique la familia lingüística</label
          >
          <input
            type="text"
            name="otraLengua"
            id="otraLenguaInput"
            class="acentos border border-gray-300 w-full p-3 rounded-md bg-gray-50 uppercase"
            value="<%= otraFamiliaTexto %>"
            <%= familiaSeleccionada === 'OTRA' ? 'required' : '' %>
          />
        </div>
<!------------------------Lengua de señas Mexicanas------------------------------------------------------------>
        <div class="mb-3">
          <label class="block mb-1 font-bold text-gray-700">
            ¿Interpretas la Lengua de Señas Mexicana (LSM)?
          </label>
          <div class="flex gap-4">
            <% 
              // CORRECCIÓN: El campo en BD es lenguajeSenias (según app.js)
              const respuestaLSM = user.lenguajeSenias 
                ? String(user.lenguajeSenias).trim() 
                : 'No';  // por defecto No si no existe
            %>

            <label class="flex items-center cursor-pointer">
              <input
                type="radio"
                name="lenguaSenias"
                value="Sí"
                class="mr-2"
                <%= respuestaLSM === 'Sí' ? 'checked' : '' %>
                required
                data-toggle="nivel-lsm"
              />
              Sí
            </label>

            <label class="flex items-center cursor-pointer">
              <input
                type="radio"
                name="lenguaSenias"
                value="No"
                class="mr-2"
                <%= respuestaLSM === 'No' ? 'checked' : '' %>
                data-toggle="nivel-lsm"
              />
              No
            </label>
          </div>
        </div>

        <!-- Contenedor de nivel de LSM -->
        <div id="nivelLSMContainer" class="<%= respuestaLSM === 'Sí' ? '' : 'hidden' %> mb-3">
          <label class="block mb-1 font-bold text-gray-700">
            Nivel de dominio de LSM
          </label>
          <select
            name="nivelLSM"
            id="nivelLSM"
            class="border border-gray-300 w-full p-3 rounded-md bg-gray-50"
            <%= respuestaLSM === 'Sí' ? 'required' : '' %>
          >
            <% 
              // Array completo - en MAYÚSCULAS y SIN ACENTOS (como en los otros)
              const opcionesNivel = [
                { value: "", texto: "SELECCIONA UN NIVEL" },
                { value: "BASICO", texto: "NIVEL BASICO" },
                { value: "INTERMEDIO", texto: "NIVEL INTERMEDIO" },
                { value: "AVANZADO", texto: "NIVEL AVANZADO" }
              ];

              // Valor actual normalizado
              const nivelActual = user.dominioLSM 
                ? user.dominioLSM.trim().toUpperCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "") 
                : '';
            %>

            <% 
              opcionesNivel.forEach(opcion => { 
            %>
              <option 
                value="<%= opcion.value %>" 
                <%= nivelActual === opcion.value ? 'selected' : '' %>
              >
                <%= opcion.texto %>
              </option>
            <% }); %>
          </select>

          <!-- Descripción de niveles (se mantiene visible si el contenedor está abierto) -->
          <div class="mt-2 text-sm text-gray-600 space-y-1 mb-6">
            <p><strong>Básico:</strong> Gramática básica, vocabulario fundamental, deletreo, números y cultura sorda.</p>
            <p><strong>Intermedio:</strong> Mayor vocabulario y estructuras más complejas, habilidades conversacionales.</p>
            <p><strong>Avanzado:</strong> Fluidez, precisión y comprensión profunda de matices lingüísticos y culturales.</p>
          </div>
        </div>
<!-------------------------Tipo de sangre del trabajador-------------------------------------->
        <div class="my-3">
          <label class="block mb-1 font-bold text-gray-700">
            Tipo de sangre del trabajador
          </label>
          <select
            class="border border-gray-300 w-full p-3 rounded-md bg-gray-50"
            name="sangre"
            id="sangre-opciones"
            required
          >
            <% 
              // Array completo con TODAS las opciones
              const opcionesSangre = [
                { value: "", texto: "SELECCIONE SU TIPO" },
                { value: "O+", texto: "O+" },
                { value: "O-", texto: "O-" },
                { value: "A+", texto: "A+" },
                { value: "A-", texto: "A-" },
                { value: "B+", texto: "B+" },
                { value: "B-", texto: "B-" },
                { value: "AB+", texto: "AB+" },
                { value: "AB-", texto: "AB-" }
              ];

              // Valor actual normalizado (mayúsculas, sin espacios extras)
              const sangreActual = user.tipoSangre 
                ? user.tipoSangre.trim().toUpperCase() 
                : '';
            %>

            <% 
              // Generamos todas las opciones con el loop
              opcionesSangre.forEach(opcion => { 
            %>
              <option 
                value="<%= opcion.value %>" 
                <%= sangreActual === opcion.value ? 'selected' : '' %>
              >
                <%= opcion.texto %>
              </option>
            <% }); %>
          </select>
        </div>

<!---------------------------------------------------- Discapacidad ------------------------------------>
        <div class="mb-3">
          <label class="block mb-1 font-bold text-gray-700"
            >¿Tienes alguna discapacidad?</label
          >
          <%
             // Si tipoDiscapacidad es diferente de NO y N/A, entonces es Sí
             const valDiscapacidad = user.tipoDiscapacidad ? user.tipoDiscapacidad.trim().toUpperCase() : 'NO';
             const tieneDiscapacidad = (valDiscapacidad !== 'NO' && valDiscapacidad !== 'N/A') ? '1' : '0';
          %>
          <div class="flex gap-4">
            <label
              ><input
                type="radio"
                name="discapacidad"
                value="1"
                required
                class="mr-2"
                <%= tieneDiscapacidad === '1' ? 'checked' : '' %>
              />
              Sí</label
            >
            <label
              ><input type="radio" name="discapacidad" value="0" class="mr-2" 
                <%= tieneDiscapacidad === '0' ? 'checked' : '' %>
              />
              No</label
            >
          </div>
        </div>

        <!-- Input condicional -->
        <div id="tipoDiscapacidadContainer" class="<%= tieneDiscapacidad === '1' ? '' : 'hidden' %> mb-3">
          <label class="block mb-1 text-gray-700"
            >¿Qué tipo de discapacidad tienes?</label
          >
          <% 
            const opcionesDiscapacidad = [
              "DIFICULTAD O IMPEDIMENTO PARA CAMINAR, SUBIR O BAJAR ESCALONES USANDO SUS PIERNAS",
              "DIFICULTAD O IMPEDIMENTO PARA VER, AUN USANDO LENTES",
              "DIFICULTAD O IMPEDIMENTO PARA MOVER O USAR SUS BRAZOS O MANOS",
              "DIFICULTAD O IMPEDIMENTO PARA APRENDER, RECORDAR O CONCENTRARSE POR ALGUNA CONDICIÓN INTELECTUAL, POR EJEMPLO SÍNDROME DE DOWN",
              "DIFICULTAD O IMPEDIMENTO PARA OÍR, AUN USANDO APARATO AUDITIVO",
              "DIFICULTAD O IMPEDIMENTO PARA HABLAR O COMUNICARSE (ENTENDER O SER ENTENDIDO O ENTENDIDA POR OTRAS PERSONAS)",
              "DIFICULTAD O IMPEDIMENTO PARA BAÑARSE, VESTIRSE O COMER",
              "DIFICULTAD O IMPEDIMENTO PARA REALIZAR SUS ACTIVIDADES DIARIAS POR ALGUNA CONDICIÓN EMOCIONAL O MENTAL, POR EJEMPLO ESQUIZOFRENIA O DEPRESIÓN",
              "OTRO TIPO",
              "DISCAPACIDAD NO IDENTIFICADA"
            ];
          %>
          <select
            name="tipoDiscapacidad"
            id="tipoDiscapacidadInput"
            class="border border-gray-300 w-full p-3 rounded-md bg-gray-50"
            <%= tieneDiscapacidad === '1' ? 'required' : '' %>
          >
            <option value="">Selecciona una opción</option>
            <% opcionesDiscapacidad.forEach(opcion => { %>
              <option value="<%= opcion %>" <%= valDiscapacidad === opcion ? 'selected' : '' %>><%= opcion %></option>
            <% }) %>
          </select>

          <label class="block mt-3 text-gray-700"
            >Especifica tu discapacidad</label
          >
          <input
            class="acentos border border-gray-300 p-3 rounded-md bg-gray-50 w-full uppercase mb-3"
            type="text"
            id="discapacidad-texto"
            placeholder="EJ. CEGUERA PARCIAL"
            name="discapacidadTexto"
            value="<%= user.discapacidadEspecificada && user.discapacidadEspecificada !== 'N/A' ? user.discapacidadEspecificada : '' %>"
          />
        </div>
<!-------------------------------------- Enfermedad Cronica ---------------------------------------->
        <div class="my-3">
          <label class="block mb-1 font-bold text-gray-700"
            >¿Padeces alguna enfermedad crónica o degenerativa?</label
          >
          <%
             // La BD guarda "Si" o "No" en tieneEnfermedadCronica
             const valCronica = user.tieneEnfermedadCronica ? user.tieneEnfermedadCronica.trim() : 'No';
             const esCronica = valCronica === 'Si' ? '1' : '0';
          %>
          <div class="flex gap-4">
            <label
              ><input
                type="radio"
                name="cronica"
                value="1"
                class="mr-2"
                id="radio-cronica"
                <%= esCronica === '1' ? 'checked' : '' %>
                required
              />
              Sí</label
            >
            <label
              ><input type="radio" name="cronica" value="0" class="mr-2" 
                <%= esCronica === '0' ? 'checked' : '' %>
              />
              No</label
            >
          </div>
        </div>

        <div id="preguntaCronica" class="my-3 hidden">
          <label class="block mb-1 font-bold text-gray-700"
            >¿Qué enfermedad padeces?</label
          >
          <input
            class="acentos border border-gray-300 p-3 rounded-md bg-gray-50 w-full uppercase"
            type="text"
            id="cronica-texto"
            placeholder="Enfermedad cronica"
            name="cronicaTexto"
          />
        </div>

        <!-- ¿Estás embarazada? -->
        <div id="pregunta-embarazo" class="hidden">
          <label class="block mb-1 font-bold text-gray-700"
            >¿Estás embarazada?</label
          >
          <%
             // La BD guarda "Embarazada", "No", "No aplica"
             const valEmbarazo = user.embarazada ? user.embarazada.trim() : 'No';
             const estaEmbarazada = valEmbarazo === 'Embarazada' ? '1' : '0';
          %>
          <div class="flex gap-4">
            <label
              ><input
                type="radio"
                id="radio-embarazo"
                name="embarazo"
                value="1"
                class="mr-2"
                <%= estaEmbarazada === '1' ? 'checked' : '' %>
              />
              Sí</label
            >
            <label
              ><input type="radio" name="embarazo" value="0" class="mr-2" 
                <%= estaEmbarazada === '0' ? 'checked' : '' %>
              />
              No</label
            >
          </div>
        </div>

        <!-- ¿Eres padre/madre? -->
        <div>
          <label class="block mb-1 font-bold my-4 text-gray-700"
            >¿Eres padre/madre?</label
          >
          <%
             // La BD guarda "Padre", "Madre" o "No"
             const tieneHijos = (locals.hijos && locals.hijos.length > 0);
             const valPadre = user.es_padre_madre ? user.es_padre_madre.trim() : 'No';
             const esPadre = (valPadre === 'Padre' || valPadre === 'Madre' || tieneHijos) ? '1' : '0';
          %>
          <div class="flex gap-4">
            <label
              ><input
                type="radio"
                name="papa"
                value="1"
                class="mr-2"
                id="padre"
                <%= esPadre === '1' ? 'checked' : '' %>
                required
              />
              Sí</label
            >
            <label
              ><input type="radio" name="papa" value="0" class="mr-2" 
                <%= esPadre === '0' ? 'checked' : '' %>
              />
              No</label
            >
          </div>
        </div>

        <!-- ¿Cuántos hijos tienes? -->
        <div id="preguntahijos" class="hidden">
          <label class="block my-3 font-bold text-gray-700"
            >¿Cuántos hijos tienes?</label
          >
          <input
            class="border border-gray-300 p-3 rounded-md bg-gray-50 w-32"
            type="number"
            id="hijoscontador"
            name="cantidadHijos"
            min="1"
            max="10"
            value="<%= typeof hijos !== 'undefined' && hijos && hijos.length > 0 ? hijos.length : '' %>"
            <%= (typeof hijos !== 'undefined' && hijos && hijos.length > 0) ? 'required' : '' %>
          />
        </div>

        <div id="espacioHijos">
          <% if (typeof hijos !== 'undefined' && hijos && hijos.length > 0) { %>
            <% hijos.forEach((hijo, index) => { %>
              <div class="mb-3 p-4 rounded border border-gray-300 hijo-item">
                <h3 class="font-bold text-lg mb-4 text-gray-800">Datos del Hijo <%= index + 1 %></h3>
                
                <label class="block font-medium mb-1 text-gray-700">
                  <span style="color: red;">Nombre completo</span> empezando por apellidos de la hija o hijo (sin acentos):
                </label>
                <input 
                  type="text" 
                  name="inicialesHijo<%= index %>" 
                  value="<%= hijo.inicialesHijo %>"
                  class="border rounded-full bg-gray-50 m-2 p-3 uppercase acentos" 
                  required
                >

                <label class="block font-medium mb-1 text-gray-700 mt-4">Género de la hija o hijo:</label>
                <select 
                  name="selectHijo<%= index %>" 
                  class="border rounded-full bg-gray-50 m-2 p-3" 
                  required
                >
