                    <input type="text" name="especialidad_institucion<%= i %>" required value="<%= item.institucion %>" class="border p-2 w-full rounded mb-2 acentos">
                    
                    <label class="block mb-1">Estatus</label>
                    <select name="especialidad_estatus<%= i %>" required class="border p-2 w-full rounded mb-2">
                      <option value="">Selecciona estatus</option>
                      <option value="INCONCLUSO" <%= item.estatus === 'INCONCLUSO' ? 'selected' : '' %>>INCONCLUSO</option>
                      <option value="CURSANDO" <%= item.estatus === 'CURSANDO' ? 'selected' : '' %>>CURSANDO</option>
                      <option value="CONCLUIDO" <%= item.estatus === 'CONCLUIDO' ? 'selected' : '' %>>CONCLUIDO</option>
                      <option value="TITULADO" <%= item.estatus === 'TITULADO' ? 'selected' : '' %>>TITULADO</option>
                    </select>

                    <label class="block mb-1">Documento adquirido</label>
                    <select name="especialidad_documento<%= i %>" required class="border p-2 w-full rounded mb-2">
                      <option value=""> Selecciona documento</option>
                      <option value="DIPLOMA" <%= item.documentoAdquirido === 'DIPLOMA' ? 'selected' : '' %>>DIPLOMA</option>
                      <option value="CONSTANCIA" <%= item.documentoAdquirido === 'CONSTANCIA' ? 'selected' : '' %>>CONSTANCIA</option>
                      <option value="CERTIFICADO" <%= item.documentoAdquirido === 'CERTIFICADO' ? 'selected' : '' %>>CERTIFICADO</option>
                      <option value="TITULO" <%= item.documentoAdquirido === 'TITULO' ? 'selected' : '' %>>TÍTULO</option>
                      <option value="CEDULA" <%= item.documentoAdquirido === 'CEDULA' ? 'selected' : '' %>>CÉDULA</option>
                      <option value="TITULO Y CEDULA" <%= item.documentoAdquirido === 'TITULO Y CEDULA' ? 'selected' : '' %>>TÍTULO Y CÉDULA</option>
                    </select>

                    <label class="block mb-1">Fecha de obtención del documento</label>
                    <input type="text" name="especialidad_fecha<%= i %>" required value="<%= fechaVal %>" placeholder="dd-mm-yyyy" data-format="dd-mm-yyyy" class="border p-2 w-full rounded mb-2">
                    
                    <label class="block mb-1">Cédula profesional (Si no cuenta con una deje el campo vacio)</label>
                    <input type="number" name="especialidad_cedula<%= i %>" value="<%= item.cedulaProfesional %>" placeholder="Ej. 1234567" class="border p-2 w-full rounded mb-2">
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>
        </div>
        <div class="flex justify-center">
          <label class="inline mt-4 font-bold text-verdegris text-center">
            -----------------DATOS PROFESIONALES-----------------<br />
            (CURRICULUM VITAE)</label
          >
        </div>
        <div class="border border-gray-300 p-4 rounded-md mt-4">
          <label class="block text-xl font-bold text-gray-700 mb-2"
            >Actualización profesional (Diplomas, cursos, talleres)</label
          >
          <label class="block text-xl font-bold text-gray-700 mb-2"
            >(Máximo 10)</label
          >
          <div id="espacioActualizacion" class="mt-6">
            <% if (locals.actualizacion && actualizacion.length > 0) { %>
              <% actualizacion.forEach((act, i) => { %>
                <div class="mb-4 p-4 rounded border border-gray-300 bg-gray-50">
                  <p class="font-semibold text-gray-800 mb-2">Actualización <%= i + 1 %></p>
      
                  <label class="block text-gray-700 font-semibold">Tema</label>
                  <input type="text" name="actualizacion_tema<%= i %>" value="<%= act.tema %>" class="acentos border w-full p-2 rounded-md bg-white mb-2" required>
      
                  <label class="block text-gray-700 font-semibold">Fecha (día/mes/año)</label>
                  <% 
                     let fechaVal = '';
                     if (act.fecha) {
                       try {
                         // Formato YYYY-MM-DD para input date o para flatpickr
                         fechaVal = new Date(act.fecha).toISOString().split('T')[0];
                         // Convertimos a dd-mm-yyyy para el value visual (flatpickr)
                         const [y, m, d] = fechaVal.split('-');
                         fechaVal = `${d}-${m}-${y}`;
                       } catch(e) {}
                     }
                  %>
                  <input type="text" name="actualizacion_fecha<%= i %>" value="<%= fechaVal %>" data-format="dd-mm-yyyy" class="border w-full p-2 rounded-md bg-white mb-2" placeholder="DD-MM-AAAA" required>
      
                  <label class="block text-gray-700 font-semibold">Institución</label>
                  <input type="text" name="actualizacion_institucion<%= i %>" value="<%= act.institucion %>" class="acentos border w-full p-2 rounded-md bg-white mb-2" required>
      
                  <label class="block text-gray-700 font-semibold">Documento recibido</label>
                  <select class="acentos border w-full p-2 rounded-md bg-white mb-2" name="actualizacion_documento<%= i %>" required>
                    <option value="">Seleccione documento</option>
                    <option value="CERTIFICADO" <%= act.documento === 'CERTIFICADO' ? 'selected' : '' %>>CERTIFICADO</option>
                    <option value="DIPLOMA" <%= act.documento === 'DIPLOMA' ? 'selected' : '' %>>DIPLOMA</option>
                    <option value="CONSTANCIA" <%= act.documento === 'CONSTANCIA' ? 'selected' : '' %>>CONSTANCIA</option>
                    <option value="RECONOCIMIENTO" <%= act.documento === 'RECONOCIMIENTO' ? 'selected' : '' %>>RECONOCIMIENTO</option>
                  </select>
                </div>
              <% }) %>
            <% } %>
          </div>
          <input type="hidden" id="contadorActualizacionBD" value="<%= (locals.actualizacion || []).length %>">

