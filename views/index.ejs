            >Actualizar documentos de estudios en PDF
            <span class="font-bold text-red-500">
              (un solo archivo que contenga todos los documentos)</span
            ></label
          >
          <label class="block font-semibold text-gray-800 mb-1"
            >Documentos de últimos grados de estudios (licenciaturas, maestrías,
            doctorados, postdoctorados, especialidades, diplomados, cursos,
            talleres, etc.) (Título, cédula, carta de pasante, certificado,
            constancia, etc.)</label
          >
          <% if (locals.existeGrado) { %>
            <div class="mb-2 text-green-600 font-bold text-sm">
              Documento previamente cargado <a href="/uploads/<%= user.nombreTrabajador %>_GRADO-ESTUDIOS.pdf" target="_blank" class="underline text-blue-600 ml-2">Ver actual</a>
            </div>
          <% } %>
          <input
            type="file"
            name="GRADO-ESTUDIOS"
            accept="application/pdf"
            class="mb-4"
            <%= locals.existeGrado ? '' : 'required' %>
          />
        </div>

        <!-- Experiencia laboral -->
        <div class="border border-gray-300 p-4 rounded-md mt-4">
          <label class="block text-xl font-bold text-gray-700 mb-2"
            >Experiencia Laboral dentro y fuera del Poder Judicial
            <span class="font-bold text-red-500"
              >(empezando por el cargo actual)</span
            ></label
          >
          <div id="espacioExperiencia">
            <% if (locals.experienciaPJ && experienciaPJ.length > 0) { %>
              <% experienciaPJ.forEach((exp, i) => { 
                  // Helper para convertir "ENERO 2023" -> "01-2023" para el input
                  const meses = ["ENERO", "FEBRERO", "MARZO", "ABRIL", "MAYO", "JUNIO", "JULIO", "AGOSTO", "SEPTIEMBRE", "OCTUBRE", "NOVIEMBRE", "DICIEMBRE"];
                  const formatMesAnio = (str) => {
                     if(!str) return "";
                     const parts = str.split(" "); 
                     if(parts.length < 2) return str;
                     const m = meses.indexOf(parts[0].toUpperCase());
                     if(m === -1) return str;
                     return `${String(m+1).padStart(2,'0')}-${parts[parts.length-1]}`;
                  };
                  
                  const inicio = formatMesAnio(exp.periodoInicio);
                  const esActual = (exp.periodoFin === "A LA FECHA");
                  const fin = esActual ? "" : formatMesAnio(exp.periodoFin);
                  
                  const esPJ = (exp.institucion === "PODER JUDICIAL DEL ESTADO DE HIDALGO");
                  const instValue = esPJ ? "PJ" : "OTRA";
                  const otraInstValue = esPJ ? "" : exp.institucion;
              %>
                <div class="mb-3 p-4 rounded border border-gray-300 experiencia-item">
                  <p class="font-semibold text-gray-800 mb-1">Experiencia <%= i + 1 %></p>
                  
                  <label class="block text-gray-700 font-semibold">Periodo: Mes/Año de inicio</label>
                  <input type="text" name="experiencia_inicio<%= i %>" value="<%= inicio %>" data-format="mm-yyyy" required class="border w-full p-2 rounded-md bg-gray-50 mb-2" placeholder="MM-AAAA">

                  <label class="block text-gray-700 font-semibold"> Periodo: Mes/Año de fin</label>
                  <input type="text" name="experiencia_fin<%= i %>" id="experiencia_fin<%= i %>" value="<%= fin %>" data-format="mm-yyyy" class="border w-full p-2 rounded-md bg-gray-50 <%= esActual ? 'hidden' : '' %>" placeholder="MM-AAAA" <%= esActual ? '' : 'required' %>>

                  <input type="checkbox" name="experiencia_actual<%= i %>" id="experiencia_actual<%= i %>" <%= esActual ? 'checked' : '' %>> <span class="text-red-500"> A LA FECHA </span>

                  <label class="block text-gray-700 font-semibold">Institución</label>
                  <select name="experiencia_institucion<%= i %>" class="border w-full p-2 rounded-md bg-gray-50 mb-2">
                    <option value="PJ" <%= instValue === 'PJ' ? 'selected' : '' %>>Poder Judicial del Estado de Hidalgo</option>
                    <option value="OTRA" <%= instValue === 'OTRA' ? 'selected' : '' %>>Otra</option>
                  </select>

                  <div id="adscripcion-container-<%= i %>" class="mb-2 <%= instValue === 'PJ' ? '' : 'hidden' %>">
                    <label class="block text-gray-700 font-semibold">Adscripción</label>
                    <input type="text" name="experiencia_adscripcion<%= i %>" value="<%= exp.adscripcion %>" placeholder="EJ. PRIMERA SALA CIVIL Y FAMILIAR" class="acentos border w-full p-2 rounded-md bg-gray-50">
                  </div>

                  <div id="otra-inst-container-<%= i %>" class="mb-2 <%= instValue === 'OTRA' ? '' : 'hidden' %>">
                    <label class="block text-gray-700 font-semibold">Nombre de la institución</label>
                    <input type="text" name="experiencia_otrainst<%= i %>" value="<%= otraInstValue %>" placeholder="EJ. BANCO AZTECA, S.A." class="acentos border w-full p-2 rounded-md bg-gray-50">
                  </div>

                  <label class="block text-gray-700 font-semibold">Cargo ó Puesto desempeñado</label>
                  <input type="text" name="experiencia_puesto<%= i %>" value="<%= exp.cargo %>" placeholder="Ej. SECRETARIA DE ESTUDIO Y CUENTA" required class="acentos border w-full p-2 rounded-md bg-gray-50 mb-2">

                  <label class="block text-gray-700 font-semibold">Campo de experiencia</label>
                  <input type="text" name="experiencia_campo<%= i %>" value="<%= exp.campoExperiencia %>" placeholder="Ej. ELABORACION DE PROYECTOS DE SENTENCIA DE SEGUNDA INSTANCIA" required class="acentos border w-full p-2 rounded-md bg-gray-50 mb-2">
                </div>
              <% }) %>
            <% } %>
          </div>
          <input type="hidden" id="contadorExperienciaBD" value="<%= (locals.experienciaPJ || []).length %>">
          <button
            type="button"
            onclick="agregarExperiencia()"
            class="mt-2 bg-blue-500 text-white px-4 py-2 rounded-md"
          >
            Agregar experiencia
          </button>
          <button
            type="button"
            onclick="quitarExperiencia()"
            class="mt-2 bg-red-500 text-white px-4 py-2 rounded-md"
          >
            Quitar experiencia
          </button>
        </div>

        <input
          type="hidden"
          id="experienciaTotal"
          name="experienciaTotal"
          value="0"
        />

        <div class="border border-gray-300 p-4 rounded-md mt-4">
          <label class="block text-xl font-bold text-blue-600 mb-2"
            >Actualizar documento en PDF</label
          >
          <label class="block font-semibold text-gray-800 mb-1"
            >Constancia de situación fiscal vigente
            <span class="font-bold text-red-500"
              >(que incluya actividad "Asalariado" y régimen "Sueldos y Salarios
              e Ingresos Asimilados a Salarios)</span
            ></label
          >
          <% if (locals.existeRfc) { %>
            <div class="mb-2 text-green-600 font-bold text-sm">
              ✅ Documento cargado <a href="/uploads/<%= user.nombreTrabajador %>_RFC.pdf" target="_blank" class="underline text-blue-600 ml-2">Ver actual</a>
            </div>
          <% } %>
          <input
            type="file"
            name="RFC"
            accept="application/pdf"
            class="mb-4"
            <%= locals.existeRfc ? '' : 'required' %>
          />
        </div>
        <!-- Botón -->
        <button
          type="submit"
          id="botonFormulario"
          class="w-full bg-amarilloPJ hover:bg-[#e1c27d] text-grisTexto font-semibold py-3 rounded-md transition"
        >
          Enviar
        </button>
      </div>
    </form>
    <!-- Footer -->
    <footer class="w-full bg-verdegris text-white text-center py-4 mt-auto">
      <p class="text-sm">Poder Judicial del Estado de Hidalgo</p>
