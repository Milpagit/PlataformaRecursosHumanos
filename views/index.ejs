                Sí</label
              >
              <label
                ><input
                  type="radio"
                  name="tieneBachillerato"
                  value="0"
                  class="mr-2"
                />
                No</label
              >
            </div>
          </div>
          <div id="bachilleratoContainer" class="hidden mb-4">
            <label class="block mb-1 text-gray-700">Tipo de bachillerato</label>

            <select
              name="prepa_titulo"
              class="border p-2 rounded-md bg-gray-50 w-full mb-2"
            >
              <option value="">SELECCIONE</option>
              <option value="BACHILLERATO GENERAL">BACHILLERATO GENERAL</option>
              <option value="BACHILLERATO TECNOLOGICO">
                BACHILLERATO TECNOLÓGICO
              </option>
              <option value="PROFESIONAL TECNICO">PROFESIONAL TÉCNICO</option>
              <option value="BACHILLERATO INTERCULTURAL">
                BACHILLERATO INTERCULTURAL
              </option>
            </select>

            <label class="block mb-1 text-gray-700">Estatus</label>
            <select
              name="prepa_estatus"
              id="estatus_prepa_opciones"
              class="border border-gray-300 w-full p-3 rounded-md bg-gray-50"
            >
              <option value="">Selecciona estatus</option>
              <option value="INCONCLUSO">INCONCLUSO</option>
              <option value="CURSANDO">CURSANDO</option>
              <option value="CONCLUIDO">CONCLUIDO</option>
            </select>

            <label class="block mb-1 text-gray-700">Documento adquirido</label>
            <select
              name="prepa_documento"
              id="doc_prepa_opciones"
              class="border border-gray-300 w-full p-3 rounded-md bg-gray-50 mb-2"
            >
              <option value="">Seleccione según el caso</option>
              <option value="DIPLOMA">DIPLOMA</option>
              <option value="CONSTANCIA">CONSTANCIA</option>
              <option value="CERTIFICADO">CERTIFICADO</option>
            </select>

            <label class="block mb-1 text-gray-700"
              >Institución que expidió el documento</label
            >
            <input
              type="text"
              name="prepa_institucion"
              class="acentos border p-2 rounded-md bg-gray-50 w-full mb-2"
            />

            <label class="block mb-1 text-gray-700"
              >Fecha de obtención del documento que avala los estudios</label
            >
            <input
              type="date"
              name="prepa_fecha"
              placeholder="dd-mm-yyyy"
              class="border p-2 rounded-md bg-gray-50 w-full mb-2"
            />
          </div>
          <div class="mb-4 mt-4">
            <p class="font-semibold text-gray-800 mb-1">Licenciatura</p>
            <label class="text-gray-800 mb-1">¿Cuentas con licenciatura?</label>
            <div class="flex gap-4">
              <label
                ><input
                  type="radio"
                  name="tieneLicenciatura"
                  value="1"
                  required
                  class="mr-2"
                />
                Sí</label
              >
              <label
                ><input
                  type="radio"
                  name="tieneLicenciatura"
                  value="0"
                  class="mr-2"
                />
                No</label
              >
            </div>
          </div>
          <div id="licenciaturaCantidadContainer" class="hidden mb-4">
            <label class="block mb-1 text-gray-700"
              >¿Cuántas licenciaturas tienes? (máx. 3)</label
            >
            <input
              type="number"
              id="licenciaturaCantidad"
              name="licenciaturaCantidad"
              class="border border-gray-300 w-24 p-2 rounded-md mb-2"
              min="1"
              max="3"
            />
            <div id="licenciaturaLista"></div>
          </div>

          <div class="mb-4 mt-4">
            <p class="font-semibold text-gray-800 mb-1">Maestría</p>
            <label class="text-gray-800 mb-1">¿Cuentas con maestría?</label>
            <div class="flex gap-4">
              <label
                ><input
                  type="radio"
                  name="tieneMaestria"
                  value="1"
                  required
                  class="mr-2"
                />
                Sí</label
              >
              <label
                ><input
                  type="radio"
                  name="tieneMaestria"
                  value="0"
                  class="mr-2"
                />
                No</label
              >
            </div>
          </div>
          <div id="maestriaCantidadContainer" class="hidden mb-4">
            <label class="block mb-1 text-gray-700"
              >¿Cuántas maestrías tienes? (máx. 3)</label
            >
            <input
              type="number"
              id="maestriaCantidad"
              name="maestriaCantidad"
              class="border border-gray-300 w-24 p-2 rounded-md mb-2"
              min="1"
              max="3"
            />
            <div id="maestriaLista"></div>
          </div>

          <div class="mb-4 mt-4">
            <p class="font-semibold text-gray-800 mb-1">Doctorado</p>
            <label class="text-gray-800 mb-1">¿Cuentas con doctorado?</label>
            <div class="flex gap-4">
              <label
                ><input
                  type="radio"
                  name="tieneDoctorado"
                  value="1"
                  required
                  class="mr-2"
                />
                Sí</label
              >
              <label
                ><input
                  type="radio"
                  name="tieneDoctorado"
                  value="0"
                  class="mr-2"
                />
                No</label
              >
            </div>
          </div>

          <div id="doctoradoCantidadContainer" class="hidden mb-4">
            <label class="block mb-1 text-gray-700"
              >¿Cuántos doctorados tienes? (máx. 2)</label
            >
            <input
              type="number"
              id="doctoradoCantidad"
              name="doctoradoCantidad"
              class="border border-gray-300 w-24 p-2 rounded-md mb-2"
              min="1"
              max="2"
            />
            <div id="doctoradoLista"></div>
          </div>
          <div class="mb-4 mt-4">
            <p class="font-semibold text-gray-800 mb-1">Posdoctorado</p>
            <label class="text-gray-800 mb-1">¿Cuentas con posdoctorado?</label>
            <div class="flex gap-4">
              <label
                ><input
                  type="radio"
                  name="tienePosdoctorado"
                  value="1"
                  required
                  class="mr-2"
                />
                Sí</label
              >
              <label
                ><input
                  type="radio"
                  name="tienePosdoctorado"
                  value="0"
                  class="mr-2"
                />
                No</label
              >
            </div>
          </div>
          <div id="posdoctoradoCantidadContainer" class="hidden mb-4">
            <label class="block mb-1 text-gray-700"
              >¿Cuántos Posdoctorados tienes? (máx. 2)</label
            >
            <input
              type="number"
              id="posdoctoradoCantidad"
              name="posdoctoradoCantidad"
              class="border border-gray-300 w-24 p-2 rounded-md mb-2"
              min="1"
              max="2"
            />
            <div id="posdoctoradoLista"></div>
          </div>

          <div class="mb-4 mt-4">
            <p class="font-semibold text-gray-800 mb-1">Especialidad</p>
            <label class="text-gray-800 mb-1">¿Cuentas con especialidad?</label>
            <div class="flex gap-4">
              <label
                ><input
                  type="radio"
                  name="tieneEspecialidad"
                  value="1"
                  required
                  class="mr-2"
                />
                Sí</label
              >
              <label
                ><input
                  type="radio"
                  name="tieneEspecialidad"
                  value="0"
                  class="mr-2"
                />
                No</label
              >
            </div>
          </div>
          <div id="especialidadCantidadContainer" class="hidden mb-4">
            <label class="block mb-1 text-gray-700"
              >¿Cuántas especialidades tienes? (máx. 3)</label
            >
            <input
              type="number"
              id="especialidadCantidad"
              name="especialidadCantidad"
              class="border border-gray-300 w-24 p-2 rounded-md mb-2"
              min="1"
              max="3"
            />
            <div id="especialidadLista"></div>
          </div>
        </div>
        <div class="flex justify-center">
          <label class="inline mt-4 font-bold text-verdegris text-center">
            -----------------DATOS PROFESIONALES-----------------<br />
            (CURRICULUM VITAE)</label
          >
        </div>
        <div class="border border-gray-300 p-4 rounded-md mt-4">
          <label class="block text-xl font-bold text-gray-700 mb-2"
            >Actualización profesional (Diplomas, cursos, talleres)</label
          >
          <label class="block text-xl font-bold text-gray-700 mb-2"
            >(Máximo 10)</label
          >
          <div id="espacioActualizacion" class="mt-6"></div>

          <input
            type="hidden"
            name="actualizacionTotal"
            id="actualizacionTotal"
            value="0"
          />

          <button
            type="button"
            onclick="agregarActualizacion()"
            class="mt-2 bg-blue-500 text-white px-4 py-2 rounded-md"
          >
            + Agregar actualización profesional
          </button>

          <button
            type="button"
            onclick="quitarActualizacion()"
            class="bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700 mt-2"
          >
            - Quitar última actualización
          </button>
        </div>

        <div class="border border-gray-300 p-4 rounded-md mt-4">
          <label class="block text-xl font-bold text-blue-600 mb-2"
            >Actualizar documentos de estudios en PDF
            <span class="font-bold text-red-500">
              (un solo archivo que contenga todos los documentos)</span
            ></label
          >
          <label class="block font-semibold text-gray-800 mb-1"
            >Documentos de últimos grados de estudios (licenciaturas, maestrías,
            doctorados, postdoctorados, especialidades, diplomados, cursos,
            talleres, etc.) (Título, cédula, carta de pasante, certificado,
            constancia, etc.)</label
          >
          <input
            type="file"
            name="GRADO-ESTUDIOS"
            accept="application/pdf"
            class="mb-4"
            required
          />
        </div>

        <!-- Experiencia laboral -->
        <div class="border border-gray-300 p-4 rounded-md mt-4">
          <label class="block text-xl font-bold text-gray-700 mb-2"
            >Experiencia Laboral dentro y fuera del Poder Judicial
            <span class="font-bold text-red-500"
              >(empezando por el cargo actual)</span
            ></label
          >
          <div id="espacioExperiencia"></div>
          <button
            type="button"
            onclick="agregarExperiencia()"
            class="mt-2 bg-blue-500 text-white px-4 py-2 rounded-md"
          >
            Agregar experiencia
          </button>
          <button
            type="button"
            onclick="quitarExperiencia()"
            class="mt-2 bg-red-500 text-white px-4 py-2 rounded-md"
          >
            Quitar experiencia
          </button>
        </div>

        <input
          type="hidden"
          id="experienciaTotal"
          name="experienciaTotal"
          value="0"
        />

        <div class="border border-gray-300 p-4 rounded-md mt-4">
          <label class="block text-xl font-bold text-blue-600 mb-2"
            >Actualizar documento en PDF</label
          >
          <label class="block font-semibold text-gray-800 mb-1"
            >Constancia de situación fiscal vigente
            <span class="font-bold text-red-500"
              >(que incluya actividad "Asalariado" y régimen "Sueldos y Salarios
              e Ingresos Asimilados a Salarios)</span
            ></label
          >
          <input
            type="file"
            name="RFC"
            accept="application/pdf"
            class="mb-4"
            required
          />
        </div>
        <!-- Botón -->
        <button
          type="submit"
          id="botonFormulario"
          class="w-full bg-amarilloPJ hover:bg-[#e1c27d] text-grisTexto font-semibold py-3 rounded-md transition"
        >
          Enviar
        </button>
      </div>
    </form>
    <!-- Footer -->
    <footer class="w-full bg-verdegris text-white text-center py-4 mt-auto">
      <p class="text-sm">Poder Judicial del Estado de Hidalgo</p>
    </footer>
    <!-- Inputmask -->
    <script src="https://cdn.jsdelivr.net/npm/inputmask@5.0.8/dist/inputmask.min.js"></script>

    <!-- Flatpickr -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/plugins/monthSelect/index.js"></script>

    <!-- JS -->
    <script src="/js/formulario.js"></script>
  </body>
</html>
