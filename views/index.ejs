                    <select name="posdoctorado_documento<%= i %>" required class="border p-2 w-full rounded mb-2">
                      <option value=""> Selecciona documento</option>
                      <option value="DIPLOMA" <%= item.documentoAdquirido === 'DIPLOMA' ? 'selected' : '' %>>DIPLOMA</option>
                      <option value="CONSTANCIA" <%= item.documentoAdquirido === 'CONSTANCIA' ? 'selected' : '' %>>CONSTANCIA</option>
                      <option value="CERTIFICADO" <%= item.documentoAdquirido === 'CERTIFICADO' ? 'selected' : '' %>>CERTIFICADO</option>
                      <option value="TITULO" <%= item.documentoAdquirido === 'TITULO' ? 'selected' : '' %>>TÍTULO</option>
                      <option value="CEDULA" <%= item.documentoAdquirido === 'CEDULA' ? 'selected' : '' %>>CÉDULA</option>
                      <option value="TITULO Y CEDULA" <%= item.documentoAdquirido === 'TITULO Y CEDULA' ? 'selected' : '' %>>TÍTULO Y CÉDULA</option>
                    </select>

                    <label class="block mb-1">Fecha de obtención del documento</label>
                    <input type="text" name="posdoctorado_fecha<%= i %>" required value="<%= fechaVal %>" placeholder="dd-mm-yyyy" data-format="dd-mm-yyyy" class="border p-2 w-full rounded mb-2">
                    
                    <label class="block mb-1">Cédula profesional (Si no cuenta con una deje el campo vacio)</label>
                    <input type="number" name="posdoctorado_cedula<%= i %>" value="<%= item.cedulaProfesional %>" placeholder="Ej. 1234567" class="border p-2 w-full rounded mb-2">
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>

          <div class="mb-4 mt-4">
            <p class="font-semibold text-gray-800 mb-1">Especialidad</p>
            <%
              const especialidadesBD = (locals.escolaridad || []).filter(e => e.nivelAcademico === 'ESPECIALIDAD');
              const numEspecialidades = especialidadesBD.length;
              const tieneEsp = numEspecialidades > 0 ? '1' : '0';
            %>
            <label class="text-gray-800 mb-1">¿Cuentas con especialidad?</label>
            <div class="flex gap-4">
              <label
                ><input
                  type="radio"
                  name="tieneEspecialidad"
                  value="1"
                  <%= tieneEsp === '1' ? 'checked' : '' %>
                  required
                  class="mr-2"
                />
                Sí</label
              >
              <label
                ><input
                  type="radio"
                  name="tieneEspecialidad"
                  value="0"
                  <%= tieneEsp === '0' ? 'checked' : '' %>
                  class="mr-2"
                />
                No</label
              >
            </div>
