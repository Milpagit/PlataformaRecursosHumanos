            class="acentos border border-gray-300 w-full p-3 rounded-md bg-gray-50 uppercase"
          />

          <label class="block mb-1 text-gray-700">Estado</label>
          <input
            type="text"
            name="actual_estado"
            class="acentos border border-gray-300 w-full p-3 rounded-md bg-gray-50 uppercase"
          />

          <label class="block mb-1 text-gray-700">Código Postal</label>
          <input
            type="number"
            name="actual_codigopostal"
            class="border border-gray-300 w-full p-3 rounded-md bg-gray-50"
          />
        </div>

        <div class="border border-gray-300 p-4 rounded-md mt-4">
          <label class="block text-xl font-bold text-blue-600 mb-2"
            >Actualizar documento en PDF</label
          >

          <label class="block font-semibold text-gray-800 mb-1"
            >Comprobante de domicilio vigente</label
          >
