  <body
    class="bg-gray-100 font-sans text-grisTexto flex flex-col items-center min-h-screen"
  >
    <!-- ENCABEZADO PRINCIPAL -->
    <header class="w-full bg-verdegris text-white py-6 shadow-md">
      <div class="container mx-auto flex items-center justify-center">
        <img src="/images/pj-logo.png" alt="Logo PJ" class="w-20 h-auto mr-4" />
        <h1 class="text-2xl md:text-3xl font-bold uppercase tracking-wide">
          PODER JUDICIAL DEL ESTADO DE HIDALGO
        </h1>
        <img
          src="/images/consejo-logo.png"
          alt="Logo PJ"
          class="w-24 h-auto mr-4"
        />
      </div>
    </header>

    <section class="w-full py-2">
      <div class="container mx-auto text-center space-y-1">
        <!-- Nivel 1: más destacado -->
        <h3
          class="text-xl md:text-2xl font-extrabold text-verdegris uppercase tracking-wide"
        >
          Consejo de la Judicatura
        </h3>
        <div class="mx-auto w-16 border-t-2 border-verdegris"></div>
        <!-- Nivel 2 -->
        <p class="text-lg font-bold text-grisTexto uppercase tracking-normal">
          Comisión de Administración
        </p>
        <div class="mx-auto w-12 border-t border-grisTexto"></div>
        <!-- Nivel 3 -->
        <p
          class="text-base font-semibold text-grisTexto uppercase tracking-wide"
        >
          Coordinación General de Administración
        </p>
        <div class="mx-auto w-8 border-t border-grisTexto"></div>
        <!-- Nivel 4 -->
        <p class="text-sm font-medium text-grisTexto uppercase tracking-wide">
          Dirección de Recursos Humanos
        </p>
      </div>
    </section>

    <!-- FRASE INSTITUCIONAL 
  <p class="italic text-green-800 font-medium text-xl mx-auto mt-4">
    “POR LA JUSTICIA QUE MERECEMOS.”
  </p> -->

    <!-- TÍTULOS DE LA PÁGINA -->

    <!-- FORMULARIO PRINCIPAL -->
    <form
      id="form-trabajador"
      action="/guardar"
      method="POST"
      enctype="multipart/form-data"
      class="mt-8 mb-14 w-full max-w-xl bg-white rounded-xl shadow-lg border p-8 space-y-6"
    >
      <!-- SECCIÓN DE DATOS BÁSICOS -->
      <h2 class="text-center text-2xl font-bold text-verdegris uppercase">
        Cédula de datos personales, académicos y profesionales
      </h2>
      <!-- <p class="text-center text-sm text-grisTexto mb-4">
      Si alguno de los primeros 4 datos no es correcto, acude a Recursos Humanos.
    </p> -->

      <div>
        <label class="block mb-1 font-medium text-gray-700"
          >No. de Trabajador</label
        >
        <input
          type="number"
          name="noTrabajador"
          value="<%= user.noTrabajador %>"
          disabled
          class="w-full p-3 border border-gray-300 rounded-md bg-gray-50"
        />
      </div>

      <div>
        <label class="block mb-1 font-medium text-gray-700"
          >Nombre Completo</label
        >
        <input
          type="text"
          name="nombre"
          value="<%= user.nombreTrabajador %>"
          disabled
          class="w-full p-3 border border-gray-300 rounded-md bg-gray-50"
        />
      </div>

      <div>
        <label class="block mb-1 font-medium text-gray-700">CURP</label>
        <input
          type="text"
          name="curp"
          value="<%= user.curp %>"
          disabled
          class="w-full p-3 border border-gray-300 rounded-md bg-gray-50"
        />
      </div>

      <div>
        <label class="block mb-1 font-medium text-gray-700">RFC</label>
        <input
          type="text"
          name="rfc"
          value="<%= user.rfc %>"
          disabled
          class="w-full p-3 border border-gray-300 rounded-md bg-gray-50"
        />
      </div>

      <div class="mt-12 text-center px-4">
        <h1 class="text-3xl font-bold text-amarilloPJ mb-2">
          Ingresa tus datos
        </h1>
        <p class="text-gray-600 max-w-xl mx-auto">
          Por favor, revisa e ingresa tus datos en el formulario.
        </p>
        <p class="text-gray-600 max-w-xl mx-auto">
          Asegúrate de que sean correctos.
        </p>
      </div>

      <div class="mb-3">
        <label class="block mb-1 text-gray-700 font-bold"
          >Fecha de Ingreso</label
        >
        <input
          type="text"
          class="border border-gray-300 w-full p-3 rounded-md bg-gray-50"
          id="fechaIngreso"
          name="fechaIngreso"
          data-format="dd-mm-yyyy"
          placeholder="dd-mm-yyyy"
          value="<%= user.fechaIngreso ? user.fechaIngreso.split('-').reverse().join('-') : '' %>"
          required
          />
      </div>

