<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Curriculum Vitae</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500;700;800&family=Source+Sans+3:wght@400;600;700&display=swap');

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background: #f6f7f7;
        font-family: 'Source Sans 3', 'Segoe UI', sans-serif;
        color: #1f2d28;
        padding: 26px 18px 40px;
      }

      .cv-page {
        max-width: 980px;
        margin: 0 auto;
        border: 1px solid #d4dcd8;
        border-radius: 20px;
        background: #fcfcfb;
        box-shadow: none;
        overflow: hidden;
      }

      .cv-actions {
        max-width: 980px;
        margin: 22px auto 0;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
      }

      .cv-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #4a7d59;
        background: #4a7d59;
        color: #fff;
        padding: 11px 18px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.3px;
        cursor: pointer;
        box-shadow: none;
        transition: background-color 0.2s ease;
      }

      .cv-button:hover {
        background: #3f6d4d;
      }

      .header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 26px 28px 22px;
        background: #f4f7f5;
        border-bottom: 1px solid #d5dfd9;
      }

      .logo {
        width: 84px;
        height: auto;
        padding: 6px;
        background: #fff;
        border-radius: 12px;
        border: 1px solid #d8e1dc;
      }

      .linea-titulo {
        text-align: center;
        font-family: 'Montserrat', 'Source Sans 3', sans-serif;
        font-weight: 700;
        font-size: 20px;
        letter-spacing: 0.7px;
        border-top: 1px solid #dde4e0;
        background: #f4f7f5;
        padding: 7px 12px;
      }

      .barra-seccion {
        font-family: 'Montserrat', 'Source Sans 3', sans-serif;
        font-size: 16px;
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 800;
        text-align: center;
        color: #f5f8f7;
        background: #738f81;
        border: 1px solid #738f81;
        border-radius: 12px;
        padding: 10px 12px;
        margin-bottom: 12px;
      }

      .seccion {
        margin: 14px 18px;
        padding: 14px;
        border: 1px solid #e4ebe7;
        border-radius: 16px;
        background: #ffffff;
      }

      .resumen-tabla {
        border-radius: 12px;
        overflow: hidden;
      }

      .tabla {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        background: #fff;
      }

      .tabla td,
      .tabla th {
        border: 1px solid #ced8d2;
        padding: 9px 10px;
        font-size: 13px;
        vertical-align: middle;
        line-height: 1.25;
        white-space: normal;
        word-break: break-word;
        overflow-wrap: anywhere;
        hyphens: none;
      }

      .tabla th {
        background: #eaf1ee;
        color: #193e31;
        text-align: center;
        font-weight: 700;
        line-height: 1.2;
        font-size: 12px;
      }

      .tabla tbody tr:nth-child(even) {
        background: #f8fbf9;
      }

      .etiqueta {
        width: 19%;
        background: #e9f0ec;
        font-weight: 700;
        color: #1a4435;
      }

      .valor {
        text-align: center;
        font-weight: 700;
        font-size: 15px;
        letter-spacing: 0.3px;
      }

      .centro {
        text-align: center;
      }

      .resaltado {
        font-weight: 700;
      }

      .separador {
        height: 6px;
      }

      .tradicional-resumen {
        margin: 0;
      }

      .tabla-wrap {
        overflow-x: auto;
        border-radius: 12px;
      }

      .tabla-escolaridad th:nth-child(2),
      .tabla-actualizacion th:nth-child(1),
      .tabla-actualizacion th:nth-child(3),
      .tabla-experiencia th:nth-child(3) {
        font-size: 11px;
      }

      .tabla-escolaridad td:nth-child(1),
      .tabla-escolaridad td:nth-child(3),
      .tabla-actualizacion td:nth-child(2),
      .tabla-actualizacion td:nth-child(4),
      .tabla-experiencia td:nth-child(1),
      .tabla-experiencia td:nth-child(2),
      .tabla-experiencia td:nth-child(4) {
        text-align: center;
      }

      @media (max-width: 1000px) {
        body {
          padding: 16px 8px 28px;
        }

        .header {
          padding: 16px 14px;
        }

        .linea-titulo,
        .barra-seccion {
          font-size: 15px;
        }

        .tabla td,
        .tabla th,
        .separador {
          font-size: 12px;
        }

        .tabla th {
          font-size: 11px;
        }

        .cv-actions {
          justify-content: center;
        }

        .seccion {
          margin: 10px;
          padding: 10px;
        }

        .logo {
          width: 66px;
        }

        .valor {
          font-size: 13px;
        }
      }

      @media print {
        * {
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }

        body {
          background: #fff;
          padding: 0;
        }

        .noprint {
          display: none !important;
        }

        .cv-page {
          border: none;
          border-radius: 0;
          box-shadow: none;
          max-width: 100%;
        }

        .seccion {
          margin: 10px 0;
          padding: 0;
          border: none;
          background: transparent;
        }
      }
    </style>
  </head>
  <body>
    <%
      const nivelOrden = [
        "LICENCIATURA",
        "MAESTRIA",
        "DOCTORADO",
        "POSDOCTORADO",
        "ESPECIALIDAD",
      ];
      const escolaridadPorNivel = {};

      nivelOrden.forEach((nivel) => {
        escolaridadPorNivel[nivel] = [];
      });

      (escolaridad || []).forEach((fila) => {
        const nivel = String(fila.nivelAcademico || "").toUpperCase().trim();
        if (!nivel) return;
        if (escolaridadPorNivel[nivel]) {
          escolaridadPorNivel[nivel].push(fila);
        }
      });

      function aFecha(valor) {
        if (!valor) return null;
        const d = new Date(valor);
        if (Number.isNaN(d.getTime())) return null;
        return d;
      }

      function mesAnio(valor) {
        const d = aFecha(valor);
        if (!d) return "N/D";
        const meses = [
          "ENERO",
          "FEBRERO",
          "MARZO",
          "ABRIL",
          "MAYO",
          "JUNIO",
          "JULIO",
          "AGOSTO",
          "SEPTIEMBRE",
          "OCTUBRE",
          "NOVIEMBRE",
          "DICIEMBRE",
        ];
        return meses[d.getMonth()] + " " + d.getFullYear();
      }
    %>

    <div class="cv-page" id="cvTradicional">
      <div class="header">
        <img src="/images/pj-logo-verde.png" alt="Logo Poder Judicial" class="logo" />
        <img src="/images/consejo-logo-verde.png" alt="Logo Consejo" class="logo" />
      </div>

      <div class="linea-titulo">PODER JUDICIAL DEL ESTADO DE HIDALGO</div>
      <div class="linea-titulo">CONSEJO DE LA JUDICATURA</div>
      <div class="linea-titulo">COORDINACION GENERAL DE ADMINISTRACION</div>
      <div class="seccion">
        <div class="barra-seccion">CURRICULUM VITAE</div>

        <table class="tabla tradicional-resumen resumen-tabla">
          <tr>
            <td class="etiqueta">NOMBRE</td>
            <td class="valor"><%= trabajador?.nombreTrabajador || "N/D" %></td>
          </tr>
        </table>
      </div>

      <div class="seccion">
        <div class="barra-seccion">ESCOLARIDAD</div>
        <div class="tabla-wrap">
          <table class="tabla tabla-escolaridad">
            <thead>
              <tr>
                <th style="width: 16%">GRADO</th>
                <th style="width: 26%">NOMBRE DE LA LICENCIATURA, MAESTRIA, DOCTORADO O ESPECIALIDAD</th>
                <th style="width: 18%">FECHA DE OBTENCION DE GRADO (MES / ANO)</th>
                <th style="width: 24%">INSTITUCION QUE EXPIDIO EL TITULO</th>
              </tr>
            </thead>
            <tbody>
              <% nivelOrden.forEach((nivel) => { %>
                <% (escolaridadPorNivel[nivel] || []).forEach((dato) => { %>
                  <tr>
                    <td class="resaltado"><%= nivel %></td>
                    <td><%= dato.nombreTitulo || "N/D" %></td>
                    <td><%= mesAnio(dato.fechaObtencion) %></td>
                    <td><%= dato.institucion || "N/D" %></td>
                  </tr>
                <% }) %>
              <% }) %>

              <% if (!nivelOrden.some((nivel) => (escolaridadPorNivel[nivel] || []).length > 0)) { %>
                <tr>
                  <td class="centro" colspan="4">Sin Escolaridad</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="seccion">
        <div class="barra-seccion">ACTUALIZACION PROFESIONAL (DIPLOMADOS, CURSOS, TALLERES)</div>
        <div class="tabla-wrap">
          <table class="tabla tabla-actualizacion">
            <thead>
              <tr>
                <th style="width: 31%">TEMA</th>
                <th style="width: 17%">FECHA</th>
                <th style="width: 28%">INSTITUCION</th>
                <th style="width: 24%">DOCUMENTO QUE LO ACREDITA</th>
              </tr>
            </thead>
            <tbody>
              <% if (actualizacion && actualizacion.length > 0) { %>
                <% actualizacion.forEach((act) => { %>
                  <tr>
                    <td><%= act.tema || "N/D" %></td>
                    <td><%= mesAnio(act.fecha) %></td>
                    <td><%= act.institucion || "N/D" %></td>
                    <td><%= act.documento || "N/D" %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td class="centro" colspan="4">Sin Actualizaciones</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="seccion">
        <div class="barra-seccion">EXPERIENCIA LABORAL</div>
        <div class="tabla-wrap">
          <table class="tabla tabla-experiencia">
            <thead>
              <tr>
                <th style="width: 16%">PERIODO: MES/ANO DE INICIO</th>
                <th style="width: 16%">PERIODO: MES/ANO DE TERMINO</th>
                <th style="width: 26%">DENOMINACION DE LA INSTITUCION O EMPRESA</th>
                <th style="width: 20%">CARGO O PUESTO DESEMPENADO</th>
                <th style="width: 22%">CAMPO DE EXPERIENCIA</th>
              </tr>
            </thead>
            <tbody>
              <% if (experienciaPJ && experienciaPJ.length > 0) { %>
                <% experienciaPJ.forEach((exp) => { %>
                  <tr>
                    <td><%= mesAnio(exp.periodoInicio) %></td>
                    <td><%= mesAnio(exp.periodoFin) %></td>
                    <td><%= exp.institucion || exp.adscripcion || "N/D" %></td>
                    <td><%= exp.cargo || "N/D" %></td>
                    <td><%= exp.campoExperiencia || "N/D" %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td class="centro" colspan="5">Sin Experiencias</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="cv-actions noprint">
      <button type="button" class="cv-button" onclick="imprimirCV()">
        Imprimir
      </button>
      <button type="button" class="cv-button" onclick="descargarPDF()">
        Descargar
      </button>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>
      async function descargarPDF() {
        const { jsPDF } = window.jspdf;
        const elementos = document.querySelectorAll('.noprint');
        const estilosOriginales = [];

        elementos.forEach((el) => {
          estilosOriginales.push(el.style.display);
          el.style.display = 'none';
        });

        await new Promise((resolve) => setTimeout(resolve, 100));

        const elemento = document.querySelector('.cv-page');
        const canvas = await html2canvas(elemento, {
          scale: 2,
          useCORS: true,
          logging: false,
          allowTaint: true,
          backgroundColor: '#ffffff',
        });

        const pdf = new jsPDF({
          orientation: 'p',
          unit: 'pt',
          format: 'letter',
        });

        const pageWidth = pdf.internal.pageSize.getWidth();
        const pageHeight = pdf.internal.pageSize.getHeight();
        const margin = 36;
        const usableWidth = pageWidth - margin * 2;
        const usableHeight = pageHeight - margin * 2;
        const ratio = usableWidth / canvas.width;
        const scaledHeight = canvas.height * ratio;

        let yOffset = 0;

        while (yOffset < canvas.height) {
          const sourceHeight = Math.min(usableHeight / ratio, canvas.height - yOffset);
          const tempCanvas = document.createElement('canvas');
          tempCanvas.width = canvas.width;
          tempCanvas.height = sourceHeight;

          const ctx = tempCanvas.getContext('2d');
          ctx.drawImage(
            canvas,
            0,
            yOffset,
            canvas.width,
            sourceHeight,
            0,
            0,
            canvas.width,
            sourceHeight,
          );

          const pageImage = tempCanvas.toDataURL('image/jpeg', 0.95);

          if (yOffset > 0) {
            pdf.addPage();
          }

          pdf.addImage(
            pageImage,
            'JPEG',
            margin,
            margin,
            usableWidth,
            sourceHeight * ratio,
          );

          yOffset += sourceHeight;
        }

        elementos.forEach((el, index) => {
          el.style.display = estilosOriginales[index];
        });

        pdf.save(`curriculum_${Date.now()}.pdf`);
      }

      function imprimirCV() {
        const elementos = document.querySelectorAll('.noprint');
        const estilosOriginales = [];

        elementos.forEach((el) => {
          estilosOriginales.push(el.style.display);
          el.style.display = 'none';
        });

        setTimeout(() => {
          window.print();

          setTimeout(() => {
            elementos.forEach((el, index) => {
              el.style.display = estilosOriginales[index];
            });
          }, 100);
        }, 100);
      }
    </script>
  </body>
</html>
