<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/css/styles.css" rel="stylesheet" />
    <title>Reporte</title>
  </head>

  <body class="text-lg bg-gray-100 flex flex-col items-center min-h-screen">
    <!-- Encabezado -->
    <header
      class="w-full bg-verdegris shadow-md flex justify-center items-center py-4"
    >
      <img src="/images/pj-logo.png" alt="Logo" class="mr-12 w-20 h-auto" />
      <label class="text-xl md:text-2xl font-bold text-white"
        >PODER JUDICIAL DEL ESTADO DE HIDALGO</label
      >
      <img
        src="/images/consejo-logo.png"
        alt="Logo PJ"
        class="w-20 h-auto mr-4"
      />
    </header>

    <p class="italic text-green-800 font-medium text-xl mx-auto mt-4">
      “POR LA JUSTICIA QUE MERECEMOS.”
    </p>

    <!-- Formulario de búsqueda -->
    <form
      onsubmit="buscarTrabajador(event)"
      class="mt-12 mb-14 bg-white p-8 rounded-xl shadow border-2 border-verdegris max-w-xl w-full flex flex-col gap-5"
    >
      <h2 class="text-2xl font-semibold text-gray-800 mb-2 text-center">
        Buscar Reporte de Trabajador
      </h2>
      <p class="text-gray-600 mb-4 text-center">
        Ingresa el número de trabajador para descargar su archivo
      </p>

      <div>
        <label class="block mb-1 font-medium text-gray-700"
          >Número de Trabajador</label
        >
        <input
          type="number"
          id="trabajadorInput"
          class="border border-gray-300 w-full p-3 rounded-md bg-gray-50"
          placeholder="Ej. 12345"
          required
        />
      </div>

      <button
        type="submit"
        class="bg-verdegris hover:opacity-90 text-white py-3 rounded-md text-lg font-semibold transition"
      >
        Buscar
      </button>
    </form>
    <form onsubmit="descargarTodos(event)">
      <button
        a
        href="/generar-reporte-todos"
        class="bg-verdegris hover:opacity-90 text-white py-3 rounded-md text-lg font-semibold transition"
      >
        Descargar todo
      </button>
      <p id="mensajeProgreso" class="text-center text-gray-700 italic mt-2"></p>
    </form>

    <!-- Footer -->
    <footer class="w-full bg-verdegris text-white text-center py-4 mt-auto">
      <p class="text-sm">
        © 2025 Poder Judicial del Estado de Hidalgo. Todos los derechos
        reservados.
      </p>
    </footer>

    <script>
      async function buscarTrabajador(event) {
        event.preventDefault();
        const noTrabajador = document
          .getElementById("trabajadorInput")
          .value.trim();
        if (!noTrabajador) {
          alert("Ingresa un número de trabajador válido.");
          return;
        }

        try {
          const response = await fetch(`/existe/${noTrabajador}`);
          const data = await response.json();

          if (data.existe) {
            window.location.href = `/reporte/${noTrabajador}`;
          } else {
            alert("No se encontró ningún trabajador con ese número.");
          }
        } catch (error) {
          alert("Error al verificar el número. Intenta más tarde.");
          console.error(error);
        }
      }
    </script>
    <script>
      async function descargarTodos(event) {
        event.preventDefault();
        const boton = event.target;
        const mensaje = document.getElementById("mensajeProgreso");

        boton.disabled = true;
        boton.innerText = "Generando ZIP...";
        mensaje.innerText =
          "Por favor espera, estamos generando todos los reportes. Esto puede tardar unos minutos...";

        try {
          const response = await fetch("/generar-reportes-todos");

          if (!response.ok) throw new Error("Error al generar el archivo.");

          const blob = await response.blob();
          const url = window.URL.createObjectURL(blob);

          const a = document.createElement("a");
          a.href = url;
          a.download = "REPORTE_GENERAL.zip";
          document.body.appendChild(a);
          a.click();
          a.remove();
          window.URL.revokeObjectURL(url);

          mensaje.innerText =
            "ZIP generado con éxito. La descarga debería comenzar automáticamente.";
        } catch (error) {
          mensaje.innerText = "Hubo un problema al generar el ZIP.";
          console.error(error);
        } finally {
          boton.disabled = true;
          boton.innerText = "Se ha descargado el zip general";
        }
      }
    </script>
  </body>
</html>
