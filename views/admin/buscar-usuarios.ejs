<!DOCTYPE html>
<html lang="es">
<head>
  <title>Buscar Trabajadores</title>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="/css/styles.css" rel="stylesheet" />
</head>
<body class="bg-gray-100 font-sans text-grisTexto flex flex-col min-h-screen">

  <!-- ENCABEZADO PRINCIPAL -->
  <header class="w-full bg-verdegris text-white py-6 shadow-md">
    <div class="container mx-auto flex items-center justify-between">
      <div class="flex items-center">
        <img src="/images/pj-logo.png" alt="Logo PJ" class="w-20 h-auto mr-4" />
        <h1 class="text-2xl font-bold uppercase">Buscar Trabajadores</h1>
      </div>
      <a href="/admin/dashboard" class="bg-white text-verdegris px-4 py-2 rounded font-semibold hover:bg-gray-100">
        ← Volver
      </a>
    </div>
  </header>

  <!-- CONTENIDO PRINCIPAL -->
  <main class="flex-grow container mx-auto py-8 px-4">

    <!-- BUSCADOR -->
    <div class="max-w-4xl mx-auto mb-8">
      <form action="/admin/buscar-usuarios" method="POST" class="bg-white rounded-lg shadow-lg p-6">
        <h2 class="text-xl font-bold text-verdegris mb-4">Búsqueda de Trabajadores</h2>
        
        <div class="flex gap-4">
          <input type="text" name="busqueda" placeholder="Buscar por nombre o CURP..." 
                 value="<%= busqueda %>"
                 class="flex-1 px-4 py-3 border border-gray-300 rounded-md bg-gray-50 focus:outline-none focus:ring-2 focus:ring-verdegris" />
          <button type="submit" class="bg-amarilloPJ hover:bg-[#e1c27d] text-grisTexto font-semibold px-8 py-3 rounded-md transition">
            Buscar
          </button>
        </div>
      </form>
    </div>

    <!-- MENSAJES DE ERROR -->
    <% if (error && usuarios.length === 0) { %>
      <div class="max-w-4xl mx-auto bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded mb-4">
        <%= error %>
      </div>
    <% } %>

    <!-- TABLA DE RESULTADOS -->
    <% if (usuarios && usuarios.length > 0) { %>
      <div class="max-w-4xl mx-auto bg-white rounded-lg shadow-lg overflow-hidden">
        <div class="bg-verdegris text-white px-6 py-4">
          <h3 class="text-lg font-bold">Resultados: <%= usuarios.length %> trabajador(es) encontrado(s)</h3>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-200">
              <tr>
                <th class="px-6 py-3 text-left font-semibold text-grisTexto">Nombre</th>
                <th class="px-6 py-3 text-left font-semibold text-grisTexto">CURP</th>
                <th class="px-6 py-3 text-left font-semibold text-grisTexto">RFC</th>
                <th class="px-6 py-3 text-left font-semibold text-grisTexto">Puesto</th>
                <th class="px-6 py-3 text-center font-semibold text-grisTexto">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% usuarios.forEach((usuario, index) => { %>
                <tr class="<%= index % 2 === 0 ? 'bg-white' : 'bg-gray-50' %> border-b hover:bg-gray-100 transition">
                  <td class="px-6 py-4 font-semibold"><%= usuario.nombre || 'N/A' %></td>
                  <td class="px-6 py-4"><%= usuario.curp || 'N/A' %></td>
                  <td class="px-6 py-4"><%= usuario.rfc || 'N/A' %></td>
                  <td class="px-6 py-4"><%= usuario.puestoActual || 'N/A' %></td>
                  <td class="px-6 py-4 text-center">
                    <a href="/admin/usuario/<%= usuario.idTrabajador %>" 
                       class="bg-verdegris hover:bg-[#0b6451] text-white px-4 py-2 rounded text-sm font-semibold">
                      Ver Detalles
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else if (busqueda) { %>
      <div class="max-w-4xl mx-auto text-center text-gray-500 py-8">
        <p>No hay resultados para tu búsqueda</p>
      </div>
    <% } else { %>
      <div class="max-w-4xl mx-auto text-center text-gray-500 py-8">
        <p>Ingresa un nombre o CURP para comenza la búsqueda</p>
      </div>
    <% } %>

  </main>

</body>
</html>
