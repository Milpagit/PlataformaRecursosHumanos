<!DOCTYPE html>
<html lang="es">
<head>
  <title>Panel de Administración</title>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="/css/styles.css" rel="stylesheet" />
</head>
<body class="bg-gray-100 font-sans text-grisTexto">

  <!-- ENCABEZADO PRINCIPAL -->
  <header class="w-full bg-verdegris text-white py-6 shadow-md">
    <div class="container mx-auto flex items-center justify-center">
      <img src="/images/pj-logo.png" alt="Logo PJ" class="w-24 h-auto mr-4" />
      <h1 class="text-2xl md:text-3xl font-bold uppercase tracking-wide">
        Panel de administracion 
      </h1>
      <img src="/images/consejo-logo.png" alt="Logo Consejo" class="w-24 h-auto mr-4" />
    
    </div>
  </header>

  <!-- CONTENIDO PRINCIPAL -->
  <main class="container mx-auto py-8 px-4">

    <!-- Identificación del administrador -->
    <div class="flex justify-end mt-2 mb-4 gap-3">
      <div class="flex items-center bg-white rounded-full shadow px-4 py-2 text-sm text-gray-700">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-person-circle text-verdegris" viewBox="0 0 16 16">
          <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
          <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
        </svg>
        <span class="ml-2 font-semibold"><%= admin.usuario %></span>
        <span class="ml-1 text-xs text-gray-500">· Administrador del sistema</span>
      </div>
      <a href="/admin/logout" class=" items-center flex items-center gap-3 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold px-4 py-2 rounded-full shadow">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-box-arrow-left" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M6 12.5a.5.5 0 0 0 .5.5h8a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5h-8a.5.5 0 0 0-.5.5v2a.5.5 0 0 1-1 0v-2A1.5 1.5 0 0 1 6.5 2h8A1.5 1.5 0 0 1 16 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 5 12.5v-2a.5.5 0 0 1 1 0z"/>
          <path fill-rule="evenodd" d="M.146 8.354a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L1.707 7.5H10.5a.5.5 0 0 1 0 1H1.707l2.147 2.146a.5.5 0 0 1-.708.708z"/>
        </svg>
      </a>
    </div>

    <% if (error) { %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
        <%= error %>
      </div>
    <% } %>

    <% if (mensaje) { %>
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4" id="mensajeExito">
        <%= mensaje %>
      </div>
    <% } %>

    <!-- SECCIÓN SUPERIOR: BÚSQUEDA Y ACCIONES -->
    <div class="bg-white rounded-lg shadow-lg p-6 mb-8">
      <div>
        <h2 class="text-2xl font-bold text-verdegris mb-2">Gestión de Trabajadores</h2>
      </div>

      <!-- BARRA DE BÚSQUEDA -->
      <div class="mt-6">
        <label class="block mb-2 font-semibold text-verdegris">Buscar Trabajador:</label>
        <div class="flex flex-col lg:flex-row lg:items-center gap-3">
          <!-- Input con icono de lupa integrado -->
          <div class="flex-1">
            <div class="flex items-center border border-gray-300 rounded-md bg-gray-50 px-4 py-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search text-gray-400 ml-1 mr-4" viewBox="0 0 16 16">
                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
              </svg>
              <input type="text" id="busquedaInput" placeholder="Buscar por nombre o CURP..." 
                     class="flex-1 bg-transparent border-0 focus:outline-none focus:ring-0 px-1 py-1">
            </div>
          </div>

          <!-- Botones de acción al mismo nivel -->
          <div class="flex gap-3 items-center mt-4">
            <button onclick="buscarTrabajadores()" class="flex items-center justify-center gap-2 bg-verdegris hover:bg-[#0b6451] text-white font-semibold px-6 py-2 rounded-md transition h-10">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
              </svg>
              <span class="btn-text leading-none">Buscar</span>
            </button>

            <button onclick="limpiarBusqueda()" class="flex items-center justify-center gap-16 border border-gray-300 bg-white hover:bg-gray-50 text-gray-600 font-semibold px-4 py-2 rounded-md transition h-10 shadow-sm active:scale-95">
              <div class="flex items-center gap-">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-counterclockwise" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2z"/>
                <path d="M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966a.25.25 0 0 0 .41-.192z"/>
              </svg>
              </div>
              <span class="btn-text leading-none">Limpiar</span>
            </button>

            <button onclick="abrirModal()" class="flex items-center justify-center gap-x-2 bg-amarilloPJ hover:bg-[#e1c27d] text-grisTexto font-semibold px-4 py-2 rounded-md transition duration-200 shadow-sm active:scale-95 flex-nowrap min-w-fit">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-fill-add" viewBox="0 0 16 16">
                <path d="M12.5 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7m.5-5v1h1a.5.5 0 0 1 0 1h-1v1a.5.5 0 0 1-1 0v-1h-1a.5.5 0 0 1 0-1h1v-1a.5.5 0 0 1 1 0m-2-6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                <path d="M2 13c0 1 1 1 1 1h5.256A4.5 4.5 0 0 1 8 12.5a4.5 4.5 0 0 1 1.544-3.393Q8.844 9.002 8 9c-5 0-6 3-6 4"/>
              </svg>
              
              <span class="btn-text whitespace-nowrap leading-none">Agregar trabajador</span>
            </button>

          </div>
        </div>
      </div>
    </div>



    <!-- ÚLTIMOS TRABAJADORES AGREGADOS -->
    <div id="seccionUltimos" class="bg-white rounded-lg shadow-lg p-6 mb-8">
      <h3 class="text-xl font-bold text-verdegris mb-4"> Últimos Trabajadores Agregados</h3>
      
      <% if (ultimosTrabajadores && ultimosTrabajadores.length > 0) { %>
        <!-- Vista tabla (desktop) -->
        <div class="tabla-responsive overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-200">
              <tr>
                <th class="px-6 py-3 text-left font-semibold text-grisTexto">Nombre</th>
                <th class="px-6 py-3 text-left font-semibold text-grisTexto">CURP</th>
                <th class="px-6 py-3 text-left font-semibold text-grisTexto">Clave</th>
                <th class="px-6 py-3 text-center font-semibold text-grisTexto">Acción</th>
              </tr>
            </thead>
            <tbody>
              <% ultimosTrabajadores.forEach((usuario, index) => { %>
                <tr class="<%= index % 2 === 0 ? 'bg-white' : 'bg-gray-50' %> border-b hover:bg-gray-100 transition">
                  <td class="px-6 py-4 font-semibold"><%= usuario.nombreTrabajador %></td>
                  <td class="px-6 py-4"><%= usuario.curp %></td>
                  <td class="px-6 py-4"><%= usuario.noTrabajador %></td>
                  <td class="px-6 py-4 text-center">
                    <a href="/admin/usuario/<%= usuario.idTrabajador %>" 
                       class="bg-verdegris hover:bg-[#0b6451] text-white px-4 py-2 rounded text-sm font-semibold">
                      Ver Detalles
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- Vista tarjetas (móvil) -->
        <div class="tarjetas-responsive grid gap-4">
          <% ultimosTrabajadores.forEach((usuario) => { %>
            <div class="border border-gray-200 rounded-lg shadow-sm p-4 bg-gray-50">
              <p class="text-sm font-semibold text-grisTexto mb-1"><%= usuario.nombreTrabajador %></p>
              <p class="text-xs text-gray-600"><span class="font-semibold">CURP:</span> <%= usuario.curp %></p>
              <p class="text-xs text-gray-600"><span class="font-semibold">Clave:</span> <%= usuario.noTrabajador %></p>
              <div class="mt-3 flex justify-end">
                <a href="/admin/usuario/<%= usuario.idTrabajador %>" 
                   class="inline-flex items-center justify-center bg-verdegris hover:bg-[#0b6451] text-white px-3 py-2 rounded text-xs font-semibold">
                  Ver Detalles
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p class="text-gray-500 text-center py-4">No hay trabajadores agregados aún</p>
      <% } %>
    </div>

    <!-- RESULTADOS DE BÚSQUEDA (Oculto por defecto) -->
    <div id="seccionBusqueda" class="hidden bg-white rounded-lg shadow-lg p-6">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-xl font-bold text-verdegris">🔍 Resultados de Búsqueda</h3>
        <button onclick="limpiarBusqueda()" class="text-gray-600 hover:text-gray-900 text-2xl">✕</button>
      </div>
      
      <div id="mensajeBusqueda" class="text-center text-gray-500 py-4"></div>
      
      <div id="tablaBusqueda" class="tabla-responsive hidden overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-200">
            <tr>
              <th class="px-6 py-3 text-left font-semibold text-grisTexto">Nombre</th>
              <th class="px-6 py-3 text-left font-semibold text-grisTexto">CURP</th>
              <th class="px-6 py-3 text-left font-semibold text-grisTexto">RFC</th>
              <th class="px-6 py-3 text-left font-semibold text-grisTexto">Puesto</th>
              <th class="px-6 py-3 text-center font-semibold text-grisTexto">Acciones</th>
            </tr>
          </thead>
          <tbody id="tablaBusquedaBody">
          </tbody>
        </table>
      </div>

      <!-- Tarjetas responsivas para resultados (móvil) -->
      <div id="tarjetasBusqueda" class="tarjetas-responsive hidden mt-4 grid gap-4"></div>
    </div>

    <!-- BOTÓN FINAL: REPORTE DE TRANSPARENCIA -->
    <div class="flex justify-end mb-8">
      <button type="button" onclick="abrirModalReporteTransparencia()" class="flex items-center justify-center gap-2 bg-verdegris hover:bg-[#0b6451] text-white font-semibold px-6 py-2 rounded-md shadow-sm transition">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-text" viewBox="0 0 16 16">
          <path d="M5 4a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2A.5.5 0 0 1 5 4m0 2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5A.5.5 0 0 1 5 6m0 2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5A.5.5 0 0 1 5 8m0 2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5A.5.5 0 0 1 5 10"/>
          <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5z"/>
        </svg>
        <span>Reporte de transparencia</span>
      </button>
    </div>
  </main>

  <!-- MODAL CREAR USUARIO -->
  <div id="miModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="cerrarModal()">&times;</span>
      <h2 class="text-2xl font-bold text-verdegris mb-6">Crear Nuevo Trabajador</h2>
      
      <form id="formularioCrear" onsubmit="crearTrabajador(event)">
        <!-- PERFIL DE TRABAJADOR -->
        <div id="camposTrabajador">
          <div class="mb-4">
            <label class="block mb-2 text-sm font-medium">Nombre Completo:</label>
            <input 
            type="text" 
            name="nombre" 
            required placeholder="Nombre completo"
            oninput="this.value = this.value.toUpperCase()"
            class="w-full px-4 py-3 border border-gray-300 rounded-md bg-gray-50 focus:outline-none focus:ring-2 focus:ring-verdegris">
          </div>

          <div class="mb-4">
            <label class="block mb-2 text-sm font-medium">CURP:</label>
            <input 
            type="text" 
            name="curp" 
            required placeholder="CURP (18 caracteres)" maxlength="18"
            oninput="this.value = this.value.toUpperCase()"
            class="w-full px-4 py-3 border border-gray-300 rounded-md bg-gray-50 focus:outline-none focus:ring-2 focus:ring-verdegris uppercase">
          </div>

          <div class="mb-4">
            <label class="block mb-2 text-sm font-medium">RFC:</label>
            <input 
            type="text" 
            name="rfc" 
            required placeholder="RFC (12 o 13 caracteres)" maxlength="13"
            oninput="this.value = this.value.toUpperCase()"
            class="w-full px-4 py-3 border border-gray-300 rounded-md bg-gray-50 focus:outline-none focus:ring-2 focus:ring-verdegris uppercase">
          </div>

          <div class="mb-6">
            <label 
            class="block mb-2 text-sm font-medium">Clave de Trabajador:</label>
            <input 
            type="number" 
            name="claveTrabjador" 
            required placeholder="Clave del trabajador"
            class="w-full px-4 py-3 border border-gray-300 rounded-md bg-gray-50 focus:outline-none focus:ring-2 focus:ring-verdegris">
          </div>
        </div>

        <!-- PERFIL DE ADMINISTRADOR -->
        <div class="mb-4 flex items-center gap-3">
          <input type="checkbox" id="esAdmin" name="esAdmin" class="h-4 w-4">
          <label for="esAdmin" class="text-sm font-medium">Perfil de administrador</label>
        </div>

        <div id="camposAdmin" class="mb-4 space-y-4 hidden">
          <p class="text-xs text-gray-600">Para crear un nuevo administrador, llena estos datos y confirma tu propia contraseña de administrador.</p>

          <div>
            <label class="block mb-1 text-sm font-medium">Usuario del nuevo administrador:</label>
            <input type="text" name="usuarioAdmin" placeholder="Ej. usuario2"
                   class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-50 focus:outline-none focus:ring-2 focus:ring-verdegris">
          </div>

          <div>
            <label class="block mb-1 text-sm font-medium">Correo del nuevo administrador:</label>
            <input type="email" name="correoAdmin" placeholder="correo@ejemplo.com"
                   class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-50 focus:outline-none focus:ring-2 focus:ring-verdegris">
          </div>

          <div>
            <label class="block mb-1 text-sm font-medium">Contraseña del nuevo administrador:</label>
            <input type="password" name="passwordAdmin" placeholder="Contraseña para el nuevo admin"
                   class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-50 focus:outline-none focus:ring-2 focus:ring-verdegris">
          </div>

          <div>
            <label class="block mb-1 text-sm font-medium">Tu contraseña de administrador (para confirmar):</label>
            <input type="password" name="adminPasswordActual" placeholder="Tu contraseña actual de admin"
                   class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-50 focus:outline-none focus:ring-2 focus:ring-verdegris">
          </div>
        </div>

        <div id="errorModal" class="hidden bg-red-100 border border-red-400 text-red-700 px-3 py-2 rounded mb-4 text-sm"></div>

        <div class="flex gap-3">
          <button id="btnCrearUsuario" type="submit" class="flex-1 bg-amarilloPJ hover:bg-[#e1c27d] text-grisTexto font-semibold py-3 rounded-md transition">
            Crear Trabajador
          </button>
          <button type="button" onclick="cerrarModal()" class="flex-1 bg-gray-400 hover:bg-gray-500 text-white font-semibold py-3 rounded-md transition">
            Cancelar
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL REPORTE DE TRANSPARENCIA -->
  <div id="modalReporteTransparencia" class="modal">
    <div class="modal-content">
      <span class="close" onclick="cerrarModalReporteTransparencia()">&times;</span>
      <h2 class="text-2xl font-bold text-verdegris mb-6">Reporte de transparencia</h2>

      <form id="formReporteTransparencia" method="GET" action="/admin/reporte-transparencia">
        <div class="mb-4">
          <label for="fechaInicioTransparencia" class="block mb-2 text-sm font-medium text-verdegris">Fecha de inicio del periodo que se informa</label>
          <input
            type="date"
            id="fechaInicioTransparencia"
            name="fechaInicio"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-50 focus:outline-none focus:ring-2 focus:ring-verdegris">
        </div>

        <div class="mb-6">
          <label for="fechaFinTransparencia" class="block mb-2 text-sm font-medium text-verdegris">Fecha de termino del periodo que se informa</label>
          <input
            type="date"
            id="fechaFinTransparencia"
            name="fechaFin"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-50 focus:outline-none focus:ring-2 focus:ring-verdegris">
        </div>

        <div class="flex justify-end gap-3">
          <button type="submit" class="bg-amarilloPJ hover:bg-[#e1c27d] text-grisTexto font-semibold px-6 py-2 rounded-md transition">Generar Excel</button>
          <button type="button" onclick="cerrarModalReporteTransparencia()" class="bg-gray-400 hover:bg-gray-500 text-white font-semibold px-6 py-2 rounded-md transition">Cancelar</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // Modal functions
    function abrirModal() {
      document.getElementById("miModal").classList.add("show");
    }

    function cerrarModal() {
      document.getElementById("miModal").classList.remove("show");
      document.getElementById("formularioCrear").reset();
      document.getElementById("errorModal").innerHTML = "";
      document.getElementById("errorModal").classList.add("hidden");
      document.getElementById("camposAdmin")?.classList.add("hidden");
      document.getElementById("camposTrabajador")?.classList.remove("hidden");
      const chk = document.getElementById("esAdmin");
      if (chk) chk.checked = false;
      const btn = document.getElementById("btnCrearUsuario");
      if (btn) btn.textContent = "Crear Trabajador";
    }

    // Crear trabajador
    async function crearTrabajador(event) {
      event.preventDefault();
      
      const formData = new FormData(document.getElementById("formularioCrear"));
      const esAdmin = formData.get("esAdmin") === "on";
      const datos = { esAdmin };

      if (esAdmin) {
        // Perfil de administrador: solo datos de admin
        datos.usuarioAdmin = formData.get("usuarioAdmin");
        datos.correoAdmin = formData.get("correoAdmin");
        datos.passwordAdmin = formData.get("passwordAdmin");
        datos.adminPasswordActual = formData.get("adminPasswordActual");
      } else {
        // Perfil de trabajador normal
        datos.nombre = formData.get("nombre");
        datos.curp = formData.get("curp");
        datos.rfc = formData.get("rfc");
        datos.claveTrabjador = formData.get("claveTrabjador");
      }

      try {
        const response = await fetch("/admin/crear-usuario", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(datos),
        });

        const result = await response.json();

        if (result.success) {
          cerrarModal();
          mostrarMensaje(result.mensaje, "success");
          setTimeout(() => location.reload(), 1500);
        } else {
          document.getElementById("errorModal").innerHTML = result.error;
          document.getElementById("errorModal").classList.remove("hidden");
        }
      } catch (error) {
        console.error("Error:", error);
        document.getElementById("errorModal").innerHTML = "Error al crear el trabajador";
        document.getElementById("errorModal").classList.remove("hidden");
      }
    }

    // Mostrar/ocultar campos de admin y trabajador según la casilla
    document.getElementById("esAdmin")?.addEventListener("change", (e) => {
      const cont = document.getElementById("camposAdmin");
      const trab = document.getElementById("camposTrabajador");
      const btn = document.getElementById("btnCrearUsuario");
      if (!cont || !trab || !btn) return;

      const inputsTrab = trab.querySelectorAll("input");

      if (e.target.checked) {
        cont.classList.remove("hidden");
        trab.classList.add("hidden");
        btn.textContent = "Crear Administrador";

        // Deshabilitar campos de trabajador para que no entren en la validación nativa del navegador
        inputsTrab.forEach((inp) => {
          inp.disabled = true;
          inp.required = false;
        });
      } else {
        cont.classList.add("hidden");
        trab.classList.remove("hidden");
        btn.textContent = "Crear Trabajador";

        // Rehabilitar campos de trabajador y marcar los requeridos
        inputsTrab.forEach((inp) => {
          inp.disabled = false;
        });
        const nombre = trab.querySelector("input[name='nombre']");
        const curp = trab.querySelector("input[name='curp']");
        const rfc = trab.querySelector("input[name='rfc']");
        const clave = trab.querySelector("input[name='claveTrabjador']");
        if (nombre) nombre.required = true;
        if (curp) curp.required = true;
        if (rfc) rfc.required = true;
        if (clave) clave.required = true;
      }
    });

    // Buscar trabajadores
    async function buscarTrabajadores() {
      const busqueda = document.getElementById("busquedaInput").value.trim();
      const seccionBusqueda = document.getElementById("seccionBusqueda");
      const tablaBusqueda = document.getElementById("tablaBusqueda");
      const contTarjetas = document.getElementById("tarjetasBusqueda");
      const mensajeBusqueda = document.getElementById("mensajeBusqueda");
      const seccionUltimos = document.getElementById("seccionUltimos");

      // Siempre mostrar la sección de resultados cuando se intenta buscar
      if (seccionBusqueda) seccionBusqueda.classList.remove("hidden");
      if (tablaBusqueda) tablaBusqueda.classList.add("hidden");
      if (contTarjetas) {
        contTarjetas.classList.add("hidden");
        contTarjetas.innerHTML = "";
      }
      if (mensajeBusqueda) mensajeBusqueda.innerHTML = "";
      
      if (!busqueda) {
        if (mensajeBusqueda) {
          mensajeBusqueda.innerHTML = "Ingresa un nombre o CURP para buscar";
        }
        // Volver a mostrar últimos si no se ingresó nada
        if (seccionUltimos) seccionUltimos.classList.remove("hidden");
        return;
      }

      // Ocultar la sección de últimos trabajadores cuando se hace una búsqueda válida
      if (seccionUltimos) seccionUltimos.classList.add("hidden");

      try {
        const response = await fetch("/admin/buscar-trabajadores", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ busqueda }),
        });

        const result = await response.json();

        if (result.success && result.usuarios.length > 0) {
          mostrarResultadosBusqueda(result.usuarios);
        } else {
          if (tablaBusqueda) tablaBusqueda.classList.add("hidden");
          if (mensajeBusqueda) {
            mensajeBusqueda.innerHTML = "❌ " + (result.error || "No se encontraron resultados");
          }
        }
      } catch (error) {
        console.error("Error:", error);
        if (mensajeBusqueda) {
          mensajeBusqueda.innerHTML = "Error al buscar";
        }
      }

      // Llevar la vista hacia la sección de resultados para que el admin la vea
      if (seccionBusqueda) {
        seccionBusqueda.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    function mostrarResultadosBusqueda(usuarios) {
      const tbody = document.getElementById("tablaBusquedaBody");
      tbody.innerHTML = "";

      const contTarjetas = document.getElementById("tarjetasBusqueda");
      if (contTarjetas) {
        contTarjetas.innerHTML = "";
      }

      usuarios.forEach((usuario, index) => {
        const fila = `
          <tr class="${index % 2 === 0 ? 'bg-white' : 'bg-gray-50'} border-b hover:bg-gray-100 transition">
            <td class="px-6 py-4 font-semibold">${usuario.nombreTrabajador || 'N/A'}</td>
            <td class="px-6 py-4">${usuario.curp || 'N/A'}</td>
            <td class="px-6 py-4">${usuario.rfc || 'N/A'}</td>
            <td class="px-6 py-4">${usuario.cargoActual || 'N/A'}</td>
            <td class="px-6 py-4 text-center">
              <a href="/admin/usuario/${usuario.idTrabajador}" 
                 class="bg-verdegris hover:bg-[#0b6451] text-white px-4 py-2 rounded text-sm font-semibold">
                Ver Detalles
              </a>
            </td>
          </tr>
        `;
        tbody.innerHTML += fila;

        if (contTarjetas) {
          const tarjeta = document.createElement("div");
          tarjeta.className = "border border-gray-200 rounded-lg shadow-sm p-4 bg-gray-50";
          tarjeta.innerHTML = `
            <p class="text-sm font-semibold text-grisTexto mb-1">${usuario.nombreTrabajador || 'N/A'}</p>
            <p class="text-xs text-gray-600"><span class="font-semibold">CURP:</span> ${usuario.curp || 'N/A'}</p>
            <p class="text-xs text-gray-600"><span class="font-semibold">RFC:</span> ${usuario.rfc || 'N/A'}</p>
            <p class="text-xs text-gray-600"><span class="font-semibold">Puesto:</span> ${usuario.cargoActual || 'N/A'}</p>
            <div class="mt-3 flex justify-end">
              <a href="/admin/usuario/${usuario.idTrabajador}" 
                 class="inline-flex items-center justify-center bg-verdegris hover:bg-[#0b6451] text-white px-3 py-2 rounded text-xs font-semibold">
                Ver Detalles
              </a>
            </div>
          `;
          contTarjetas.appendChild(tarjeta);
        }
      });

      document.getElementById("seccionBusqueda").classList.remove("hidden");
      document.getElementById("tablaBusqueda").classList.remove("hidden");
      if (contTarjetas) {
        contTarjetas.classList.remove("hidden");
      }
      document.getElementById("mensajeBusqueda").innerHTML = `Encontrados: ${usuarios.length} resultado(s)`;
    }

    function limpiarBusqueda() {
      document.getElementById("busquedaInput").value = "";
      document.getElementById("seccionBusqueda").classList.add("hidden");
      document.getElementById("tablaBusqueda").classList.add("hidden");
      document.getElementById("mensajeBusqueda").innerHTML = "";
      const contTarjetas = document.getElementById("tarjetasBusqueda");
      if (contTarjetas) {
        contTarjetas.classList.add("hidden");
        contTarjetas.innerHTML = "";
      }

      // Al limpiar, volvemos a mostrar la lista de últimos trabajadores
      const seccionUltimos = document.getElementById("seccionUltimos");
      if (seccionUltimos) seccionUltimos.classList.remove("hidden");
    }

    function abrirModalReporteTransparencia() {
      const modal = document.getElementById("modalReporteTransparencia");
      if (modal) modal.classList.add("show");
    }

    function cerrarModalReporteTransparencia() {
      const modal = document.getElementById("modalReporteTransparencia");
      if (modal) modal.classList.remove("show");
      const form = document.getElementById("formReporteTransparencia");
      if (form) form.reset();
    }

    function mostrarMensaje(texto, tipo) {
      const div = document.createElement("div");
      div.className = `${tipo === 'success' ? 'bg-green-100 border-green-400 text-green-700' : 'bg-red-100 border-red-400 text-red-700'} border px-4 py-3 rounded mb-4`;
      div.textContent = texto;
      document.querySelector("main").insertBefore(div, document.querySelector("main").firstChild);
      
      setTimeout(() => div.remove(), 3000);
    }

    // Enter en búsqueda
    document.getElementById("busquedaInput")?.addEventListener("keypress", (e) => {
      if (e.key === "Enter") buscarTrabajadores();
    });

    // Cerrar modal al hacer click fuera
    window.onclick = function(event) {
      const modalTrabajador = document.getElementById("miModal");
      const modalReporte = document.getElementById("modalReporteTransparencia");
      if (event.target == modalTrabajador) {
        cerrarModal();
      }
      if (event.target == modalReporte) {
        cerrarModalReporteTransparencia();
      }
    };
  </script>

</body>
</html>
