<!DOCTYPE html>
<html lang="es">
<head>
  <title>Panel de Administración</title>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <link href="/css/styles.css" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: "#4a7d59",
            "primary-dark": "#3b6548",
            "background-light": "#f6f7f7",
            amarillo: "#f0d28c",
            "amarillo-dark": "#e1c27d",
          },
          fontFamily: {
            display: ["Inter"],
          },
        },
      },
    };
  </script>

  <style>
    /* Modal overlay */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.4);
      backdrop-filter: blur(4px);
      z-index: 50;
      justify-content: center;
      align-items: center;
    }
    .modal-overlay.show {
      display: flex;
    }
    .modal-box {
      background: white;
      border-radius: 0.75rem;
      padding: 2rem;
      max-width: 32rem;
      width: 90%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
    }
  </style>
</head>
<body class="bg-background-light font-display text-slate-900 antialiased">

  <!-- ENCABEZADO PRINCIPAL -->
  <header class="w-full bg-verdegris text-white py-6 shadow-md">
    <div class="container mx-auto flex items-center justify-center">
      <img src="/images/pj-logo.png" alt="Logo PJ" class="w-24 h-auto mr-4" />
      <h1 class="text-2xl md:text-3xl font-bold uppercase tracking-wide">
        Panel de administracion 
      </h1>
      <img src="/images/consejo-logo.png" alt="Logo Consejo" class="w-24 h-auto mr-4" />
    
    </div>
  </header>

  <div class="relative flex min-h-screen flex-col">
    <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 md:px-10">

      <!-- Barra de administrador -->
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-2 text-primary font-bold text-sm uppercase tracking-wider">
          <span class="material-symbols-outlined text-base">dashboard</span>
          Panel Principal
        </div>
        <div class="flex items-center gap-3">
          <div class="flex items-center bg-white rounded-lg shadow-sm border border-slate-200 px-4 py-2 text-sm text-slate-700">
            <span class="material-symbols-outlined text-primary text-lg mr-2">account_circle</span>
            <span class="font-semibold"><%= admin.usuario %></span>
            <span class="ml-2 text-xs text-slate-400">Administrador</span>
          </div>
          <a href="/admin/logout" class="flex items-center gap-1.5 rounded-lg bg-red-50 border border-red-200 px-3 py-2 text-xs font-bold text-red-600 hover:bg-red-100 transition-colors">
            <span class="material-symbols-outlined text-sm">logout</span>
            Salir
          </a>
        </div>
      </div>

      <!-- Alertas -->
      <% if (error) { %>
        <div class="mb-6 rounded-xl bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm flex items-center gap-2">
          <span class="material-symbols-outlined text-base">error</span>
          <%= error %>
        </div>
      <% } %>

      <% if (mensaje) { %>
        <div class="mb-6 rounded-xl bg-green-50 border border-green-200 text-green-700 px-4 py-3 text-sm flex items-center gap-2" id="mensajeExito">
          <span class="material-symbols-outlined text-base">check_circle</span>
          <%= mensaje %>
        </div>
      <% } %>

      <!-- SECCIÓN: BÚSQUEDA Y ACCIONES -->
      <section class="rounded-xl bg-white p-6 shadow-sm border border-slate-200 mb-6">
        <div class="flex items-center gap-2 bg-slate-50/50 -mx-6 -mt-6 px-6 py-4 mb-6 rounded-t-xl">
          <span class="material-symbols-outlined text-primary">manage_search</span>
          <h2 class="font-bold text-lg">Gestión de Trabajadores</h2>
        </div>

        <!-- Barra de búsqueda -->
        <div class="flex flex-col lg:flex-row lg:items-end gap-4">
          <div class="flex-1">
            <label class="block mb-1.5 text-[10px] font-bold uppercase tracking-widest text-primary">Buscar Trabajador</label>
            <div class="flex items-center border border-slate-200 rounded-lg bg-slate-50 px-4 py-2.5 focus-within:ring-2 focus-within:ring-primary/20 focus-within:border-primary transition-all">
              <span class="material-symbols-outlined text-slate-400 text-lg mr-3">search</span>
              <input type="text" id="busquedaInput" placeholder="Nombre, CURP o clave del trabajador..."
                     class="flex-1 bg-transparent border-0 focus:outline-none focus:ring-0 text-sm placeholder-slate-400">
            </div>
          </div>

          <div class="flex gap-2 items-center">
            <button onclick="buscarTrabajadores()" class="flex items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-xs font-bold text-white hover:bg-primary-dark transition-colors shadow-sm">
              <span class="material-symbols-outlined text-sm">search</span>
              Buscar
            </button>

            <button onclick="limpiarBusqueda()" class="flex items-center gap-2 rounded-lg bg-white border border-slate-200 px-4 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-50 transition-colors">
              <span class="material-symbols-outlined text-sm">refresh</span>
              Limpiar
            </button>

            <button onclick="abrirModal()" class="flex items-center gap-2 rounded-lg bg-amarillo px-4 py-2.5 text-xs font-bold text-slate-800 hover:bg-amarillo-dark transition-colors shadow-sm">
              <span class="material-symbols-outlined text-sm">person_add</span>
              Agregar
            </button>
          </div>
        </div>
      </section>

      <!-- ÚLTIMOS TRABAJADORES AGREGADOS -->
      <section id="seccionUltimos" class="rounded-xl bg-white p-6 shadow-sm border border-slate-200 mb-6">
        <div class="flex items-center gap-2 bg-slate-50/50 -mx-6 -mt-6 px-6 py-4 mb-6 rounded-t-xl">
          <span class="material-symbols-outlined text-primary">group</span>
          <h3 class="font-bold text-lg">Últimos Trabajadores Agregados</h3>
        </div>
        
        <% if (ultimosTrabajadores && ultimosTrabajadores.length > 0) { %>
          <!-- Vista tabla (desktop) -->
          <div class="tabla-responsive overflow-x-auto rounded-lg border border-slate-200">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-slate-50 text-left">
                  <th class="px-5 py-3 text-[10px] font-bold uppercase tracking-widest text-primary">Nombre</th>
                  <th class="px-5 py-3 text-[10px] font-bold uppercase tracking-widest text-primary">CURP</th>
                  <th class="px-5 py-3 text-[10px] font-bold uppercase tracking-widest text-primary">Clave</th>
                  <th class="px-5 py-3 text-[10px] font-bold uppercase tracking-widest text-primary text-center">Acción</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% ultimosTrabajadores.forEach((usuario) => { %>
                  <tr class="hover:bg-slate-50/50 transition-colors">
                    <td class="px-5 py-3.5 font-semibold"><%= usuario.nombreTrabajador %></td>
                    <td class="px-5 py-3.5 text-slate-500 font-mono text-xs"><%= usuario.curp %></td>
                    <td class="px-5 py-3.5">
                      <span class="inline-flex items-center rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-bold text-primary"><%= usuario.noTrabajador %></span>
                    </td>
                    <td class="px-5 py-3.5 text-center">
                      <a href="/admin/usuario/<%= usuario.idTrabajador %>" 
                         class="inline-flex items-center gap-1.5 rounded-md bg-primary px-3 py-1.5 text-xs font-bold text-white hover:bg-primary-dark transition-colors shadow-sm">
                        <span class="material-symbols-outlined text-sm">visibility</span>
                        Ver Detalles
                      </a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <!-- Vista tarjetas (móvil) -->
          <div class="tarjetas-responsive grid gap-3">
            <% ultimosTrabajadores.forEach((usuario) => { %>
              <div class="rounded-lg border border-slate-200 p-4 bg-slate-50/50 hover:shadow-sm transition-shadow">
                <div class="flex items-start justify-between">
                  <div class="space-y-1">
                    <p class="text-sm font-bold text-slate-900"><%= usuario.nombreTrabajador %></p>
                    <p class="text-xs text-slate-500"><span class="font-semibold text-primary">CURP:</span> <%= usuario.curp %></p>
                    <p class="text-xs text-slate-500"><span class="font-semibold text-primary">Clave:</span> <%= usuario.noTrabajador %></p>
                  </div>
                  <a href="/admin/usuario/<%= usuario.idTrabajador %>" 
                     class="inline-flex items-center gap-1 rounded-md bg-primary px-2.5 py-1.5 text-xs font-bold text-white hover:bg-primary-dark transition-colors">
                    <span class="material-symbols-outlined text-sm">visibility</span>
                    Ver
                  </a>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="flex flex-col items-center justify-center py-12 text-slate-400">
            <span class="material-symbols-outlined text-5xl mb-3">person_off</span>
            <p class="text-sm">No hay trabajadores agregados aún</p>
          </div>
        <% } %>
      </section>

      <!-- RESULTADOS DE BÚSQUEDA (Oculto por defecto) -->
      <section id="seccionBusqueda" class="hidden rounded-xl bg-white p-6 shadow-sm border border-slate-200 mb-6">
        <div class="flex items-center justify-between bg-slate-50/50 -mx-6 -mt-6 px-6 py-4 mb-6 rounded-t-xl">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">search</span>
            <h3 class="font-bold text-lg">Resultados de Búsqueda</h3>
          </div>
          <button onclick="limpiarBusqueda()" class="flex items-center justify-center w-8 h-8 rounded-full hover:bg-slate-200 transition-colors text-slate-500">
            <span class="material-symbols-outlined text-lg">close</span>
          </button>
        </div>
        
        <div id="mensajeBusqueda" class="text-center text-slate-400 py-4 text-sm"></div>
        
        <div id="tablaBusqueda" class="tabla-responsive hidden overflow-x-auto rounded-lg border border-slate-200">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-slate-50 text-left">
                <th class="px-5 py-3 text-[10px] font-bold uppercase tracking-widest text-primary">Nombre</th>
                <th class="px-5 py-3 text-[10px] font-bold uppercase tracking-widest text-primary">CURP</th>
                <th class="px-5 py-3 text-[10px] font-bold uppercase tracking-widest text-primary">RFC</th>
                <th class="px-5 py-3 text-[10px] font-bold uppercase tracking-widest text-primary">Puesto</th>
                <th class="px-5 py-3 text-[10px] font-bold uppercase tracking-widest text-primary text-center">Acciones</th>
              </tr>
            </thead>
            <tbody id="tablaBusquedaBody" class="divide-y divide-slate-100">
            </tbody>
          </table>
        </div>

        <div id="tarjetasBusqueda" class="tarjetas-responsive hidden mt-4 grid gap-3"></div>
      </section>

      <!-- Reporte de Transparencia y Gestión de Admins -->
      <div class="flex justify-between mb-6">
        <a href="/admin/gestionar-admins" class="flex items-center gap-2 rounded-lg bg-white border border-primary/30 px-4 py-2.5 text-xs font-bold text-primary hover:bg-primary/5 transition-colors">
          <span class="material-symbols-outlined text-sm">admin_panel_settings</span>
          Gestión de Administradores
        </a>
        <div class="flex gap-2">
        <button type="button" onclick="abrirModalReporteTransparencia()" class="flex items-center gap-2 rounded-lg bg-white border border-primary/30 px-4 py-2.5 text-xs font-bold text-primary hover:bg-primary/5 transition-colors">
          <span class="material-symbols-outlined text-sm">summarize</span>
          Reporte de transparencia
        </button>
        </div>
      </div>

    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-200 bg-white py-6 text-center text-xs text-slate-400">
      Poder Judicial del Estado de Hidalgo &mdash; Plataforma de Recursos Humanos
    </footer>
  </div>

  <!-- MODAL CREAR USUARIO -->
  <div id="miModal" class="modal-overlay">
    <div class="modal-box">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-primary text-xl">person_add</span>
          <h2 class="text-xl font-bold text-slate-900">Crear Nuevo Trabajador</h2>
        </div>
        <button onclick="cerrarModal()" class="flex items-center justify-center w-8 h-8 rounded-full hover:bg-slate-100 transition-colors text-slate-400">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
      
      <form id="formularioCrear" onsubmit="crearTrabajador(event)">
        <!-- PERFIL DE TRABAJADOR -->
        <div id="camposTrabajador" class="space-y-4">
          <div>
            <label class="block mb-1.5 text-[10px] font-bold uppercase tracking-widest text-primary">Nombre Completo</label>
            <input type="text" name="nombre" required placeholder="Nombre completo"
                   oninput="this.value = this.value.toUpperCase()"
                   class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
          </div>

          <div>
            <label class="block mb-1.5 text-[10px] font-bold uppercase tracking-widest text-primary">CURP</label>
            <input type="text" name="curp" required placeholder="CURP (18 caracteres)" maxlength="18"
                   oninput="this.value = this.value.toUpperCase()"
                   class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-sm uppercase focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
          </div>

          <div>
            <label class="block mb-1.5 text-[10px] font-bold uppercase tracking-widest text-primary">RFC</label>
            <input type="text" name="rfc" required placeholder="RFC (12 o 13 caracteres)" maxlength="13"
                   oninput="this.value = this.value.toUpperCase()"
                   class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-sm uppercase focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
          </div>

          <div>
            <label class="block mb-1.5 text-[10px] font-bold uppercase tracking-widest text-primary">Clave de Trabajador</label>
            <input type="number" name="claveTrabjador" required placeholder="Clave del trabajador"
                   class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
          </div>

          <div>
            <label class="block mb-1.5 text-[10px] font-bold uppercase tracking-widest text-primary">Tipo de Trabajador</label>
            <div class="flex gap-6 mt-2">
              <label class="flex items-center gap-2 cursor-pointer text-sm font-medium text-slate-700">
                <input type="radio" name="tipoTrabajador" value="C" required class="h-4 w-4" style="accent-color: #738F81;">
                Confianza
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-sm font-medium text-slate-700">
                <input type="radio" name="tipoTrabajador" value="H" class="h-4 w-4" style="accent-color: #738F81;">
                Honorario
              </label>
            </div>
          </div>
        </div>

        <!-- PERFIL DE ADMINISTRADOR -->
        <div class="mt-5 pt-5 border-t border-slate-200 flex items-center gap-3">
          <input type="checkbox" id="esAdmin" name="esAdmin" class="h-4 w-4 rounded border-slate-300 text-primary focus:ring-primary">
          <label for="esAdmin" class="text-sm font-medium text-slate-700">Perfil de administrador</label>
        </div>

        <div id="camposAdmin" class="mt-4 space-y-4 hidden">
          <p class="text-xs text-slate-500 bg-slate-50 rounded-lg p-3">Para crear un nuevo administrador, llena estos datos y confirma tu propia contraseña de administrador.</p>

          <div>
            <label class="block mb-1.5 text-[10px] font-bold uppercase tracking-widest text-primary">Usuario del nuevo administrador</label>
            <input type="text" name="usuarioAdmin" placeholder="Ej. usuario2"
                   class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
          </div>

          <div>
            <label class="block mb-1.5 text-[10px] font-bold uppercase tracking-widest text-primary">Correo del nuevo administrador</label>
            <input type="email" name="correoAdmin" placeholder="correo@ejemplo.com"
                   class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
          </div>

          <div>
            <label class="block mb-1.5 text-[10px] font-bold uppercase tracking-widest text-primary">Contraseña del nuevo administrador</label>
            <input type="password" name="passwordAdmin" placeholder="Contraseña para el nuevo admin"
                   class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
          </div>

          <div>
            <label class="block mb-1.5 text-[10px] font-bold uppercase tracking-widest text-primary">Tu contraseña de administrador (para confirmar)</label>
            <input type="password" name="adminPasswordActual" placeholder="Tu contraseña actual de admin"
                   class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
          </div>
        </div>

        <div id="errorModal" class="hidden mt-4 rounded-lg bg-red-50 border border-red-200 text-red-700 px-3 py-2 text-sm flex items-center gap-2">
        </div>

        <div class="flex gap-3 mt-6">
          <button id="btnCrearUsuario" type="submit" class="flex-1 flex items-center justify-center gap-2 bg-primary hover:bg-primary-dark text-white font-bold py-2.5 rounded-lg transition-colors shadow-sm text-sm">
            <span class="material-symbols-outlined text-sm">add_circle</span>
            Crear Trabajador
          </button>
          <button type="button" onclick="cerrarModal()" class="flex-1 flex items-center justify-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold py-2.5 rounded-lg transition-colors text-sm">
            Cancelar
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL REPORTE DE TRANSPARENCIA -->
  <div id="modalReporteTransparencia" class="modal-overlay">
    <div class="modal-box">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-primary text-xl">summarize</span>
          <h2 class="text-xl font-bold text-slate-900">Reporte de transparencia</h2>
        </div>
        <button onclick="cerrarModalReporteTransparencia()" class="flex items-center justify-center w-8 h-8 rounded-full hover:bg-slate-100 transition-colors text-slate-400">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>

      <form id="formReporteTransparencia" method="GET" action="/admin/reporte-transparencia">
        <div class="space-y-4">
          <div>
            <label for="fechaInicioTransparencia" class="block mb-1.5 text-[10px] font-bold uppercase tracking-widest text-primary">Fecha de inicio del periodo</label>
            <input type="date" id="fechaInicioTransparencia" name="fechaInicio" required
                   class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
          </div>

          <div>
            <label for="fechaFinTransparencia" class="block mb-1.5 text-[10px] font-bold uppercase tracking-widest text-primary">Fecha de término del periodo</label>
            <input type="date" id="fechaFinTransparencia" name="fechaFin" required
                   class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
          </div>
        </div>

        <div class="flex justify-end gap-3 mt-6">
          <button type="submit" class="flex items-center gap-2 bg-primary hover:bg-primary-dark text-white font-bold px-5 py-2.5 rounded-lg transition-colors shadow-sm text-sm">
            <span class="material-symbols-outlined text-sm">download</span>
            Generar Excel
          </button>
          <button type="button" onclick="cerrarModalReporteTransparencia()" class="flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold px-5 py-2.5 rounded-lg transition-colors text-sm">
            Cancelar
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // Modal functions
    function abrirModal() {
      document.getElementById("miModal").classList.add("show");
    }

    function cerrarModal() {
      document.getElementById("miModal").classList.remove("show");
      document.getElementById("formularioCrear").reset();
      document.getElementById("errorModal").innerHTML = "";
      document.getElementById("errorModal").classList.add("hidden");
      document.getElementById("camposAdmin")?.classList.add("hidden");
      document.getElementById("camposTrabajador")?.classList.remove("hidden");
      const chk = document.getElementById("esAdmin");
      if (chk) chk.checked = false;
      const btn = document.getElementById("btnCrearUsuario");
      if (btn) {
        btn.innerHTML = '<span class="material-symbols-outlined text-sm">add_circle</span> Crear Trabajador';
      }
    }

    // Crear trabajador
    async function crearTrabajador(event) {
      event.preventDefault();
      
      const formData = new FormData(document.getElementById("formularioCrear"));
      const esAdmin = formData.get("esAdmin") === "on";
      const datos = { esAdmin };

      if (esAdmin) {
        datos.usuarioAdmin = formData.get("usuarioAdmin");
        datos.correoAdmin = formData.get("correoAdmin");
        datos.passwordAdmin = formData.get("passwordAdmin");
        datos.adminPasswordActual = formData.get("adminPasswordActual");
      } else {
        datos.nombre = formData.get("nombre");
        datos.curp = formData.get("curp");
        datos.rfc = formData.get("rfc");
        datos.claveTrabjador = formData.get("claveTrabjador");
        datos.tipoTrabajador = formData.get("tipoTrabajador");
      }

      try {
        const response = await fetch("/admin/crear-usuario", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(datos),
        });

        const result = await response.json();

        if (result.success) {
          cerrarModal();
          mostrarMensaje(result.mensaje, "success");
          setTimeout(() => location.reload(), 1500);
        } else {
          document.getElementById("errorModal").innerHTML = result.error;
          document.getElementById("errorModal").classList.remove("hidden");
        }
      } catch (error) {
        console.error("Error:", error);
        document.getElementById("errorModal").innerHTML = "Error al crear el trabajador";
        document.getElementById("errorModal").classList.remove("hidden");
      }
    }

    // Mostrar/ocultar campos de admin y trabajador según la casilla
    document.getElementById("esAdmin")?.addEventListener("change", (e) => {
      const cont = document.getElementById("camposAdmin");
      const trab = document.getElementById("camposTrabajador");
      const btn = document.getElementById("btnCrearUsuario");
      if (!cont || !trab || !btn) return;

      const inputsTrab = trab.querySelectorAll("input");

      if (e.target.checked) {
        cont.classList.remove("hidden");
        trab.classList.add("hidden");
        btn.innerHTML = '<span class="material-symbols-outlined text-sm">admin_panel_settings</span> Crear Administrador';

        inputsTrab.forEach((inp) => {
          inp.disabled = true;
          inp.required = false;
        });
      } else {
        cont.classList.add("hidden");
        trab.classList.remove("hidden");
        btn.innerHTML = '<span class="material-symbols-outlined text-sm">add_circle</span> Crear Trabajador';

        inputsTrab.forEach((inp) => {
          inp.disabled = false;
        });
        const nombre = trab.querySelector("input[name='nombre']");
        const curp = trab.querySelector("input[name='curp']");
        const rfc = trab.querySelector("input[name='rfc']");
        const clave = trab.querySelector("input[name='claveTrabjador']");
        if (nombre) nombre.required = true;
        if (curp) curp.required = true;
        if (rfc) rfc.required = true;
        if (clave) clave.required = true;
      }
    });

    // Buscar trabajadores
    async function buscarTrabajadores() {
      const busqueda = document.getElementById("busquedaInput").value.trim();
      const seccionBusqueda = document.getElementById("seccionBusqueda");
      const tablaBusqueda = document.getElementById("tablaBusqueda");
      const contTarjetas = document.getElementById("tarjetasBusqueda");
      const mensajeBusqueda = document.getElementById("mensajeBusqueda");
      const seccionUltimos = document.getElementById("seccionUltimos");

      if (seccionBusqueda) seccionBusqueda.classList.remove("hidden");
      if (tablaBusqueda) tablaBusqueda.classList.add("hidden");
      if (contTarjetas) {
        contTarjetas.classList.add("hidden");
        contTarjetas.innerHTML = "";
      }
      if (mensajeBusqueda) mensajeBusqueda.innerHTML = "";
      
      if (!busqueda) {
        if (mensajeBusqueda) {
          mensajeBusqueda.innerHTML = "Ingresa un nombre o CURP para buscar";
        }
        if (seccionUltimos) seccionUltimos.classList.remove("hidden");
        return;
      }

      if (seccionUltimos) seccionUltimos.classList.add("hidden");

      try {
        const response = await fetch("/admin/buscar-trabajadores", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ busqueda }),
        });

        const result = await response.json();

        if (result.success && result.usuarios.length > 0) {
          mostrarResultadosBusqueda(result.usuarios);
        } else {
          if (tablaBusqueda) tablaBusqueda.classList.add("hidden");
          if (mensajeBusqueda) {
            mensajeBusqueda.innerHTML = "No se encontraron resultados";
          }
        }
      } catch (error) {
        console.error("Error:", error);
        if (mensajeBusqueda) {
          mensajeBusqueda.innerHTML = "Error al buscar";
        }
      }

      if (seccionBusqueda) {
        seccionBusqueda.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    function mostrarResultadosBusqueda(usuarios) {
      const tbody = document.getElementById("tablaBusquedaBody");
      tbody.innerHTML = "";

      const contTarjetas = document.getElementById("tarjetasBusqueda");
      if (contTarjetas) contTarjetas.innerHTML = "";

      usuarios.forEach((usuario) => {
        const fila = `
          <tr class="hover:bg-slate-50/50 transition-colors">
            <td class="px-5 py-3.5 font-semibold">${usuario.nombreTrabajador || 'N/A'}</td>
            <td class="px-5 py-3.5 text-slate-500 font-mono text-xs">${usuario.curp || 'N/A'}</td>
            <td class="px-5 py-3.5 text-slate-500 font-mono text-xs">${usuario.rfc || 'N/A'}</td>
            <td class="px-5 py-3.5 text-slate-500">${usuario.cargoActual || 'N/A'}</td>
            <td class="px-5 py-3.5 text-center">
              <a href="/admin/usuario/${usuario.idTrabajador}" 
                 class="inline-flex items-center gap-1.5 rounded-md bg-primary px-3 py-1.5 text-xs font-bold text-white hover:bg-primary-dark transition-colors shadow-sm">
                <span class="material-symbols-outlined text-sm">visibility</span>
                Ver Detalles
              </a>
            </td>
          </tr>
        `;
        tbody.innerHTML += fila;

        if (contTarjetas) {
          const tarjeta = document.createElement("div");
          tarjeta.className = "rounded-lg border border-slate-200 p-4 bg-slate-50/50 hover:shadow-sm transition-shadow";
          tarjeta.innerHTML = `
            <div class="flex items-start justify-between">
              <div class="space-y-1">
                <p class="text-sm font-bold text-slate-900">${usuario.nombreTrabajador || 'N/A'}</p>
                <p class="text-xs text-slate-500"><span class="font-semibold text-primary">CURP:</span> ${usuario.curp || 'N/A'}</p>
                <p class="text-xs text-slate-500"><span class="font-semibold text-primary">RFC:</span> ${usuario.rfc || 'N/A'}</p>
                <p class="text-xs text-slate-500"><span class="font-semibold text-primary">Puesto:</span> ${usuario.cargoActual || 'N/A'}</p>
              </div>
              <a href="/admin/usuario/${usuario.idTrabajador}" 
                 class="inline-flex items-center gap-1 rounded-md bg-primary px-2.5 py-1.5 text-xs font-bold text-white hover:bg-primary-dark transition-colors">
                <span class="material-symbols-outlined text-sm">visibility</span>
                Ver
              </a>
            </div>
          `;
          contTarjetas.appendChild(tarjeta);
        }
      });

      document.getElementById("seccionBusqueda").classList.remove("hidden");
      document.getElementById("tablaBusqueda").classList.remove("hidden");
      if (contTarjetas) contTarjetas.classList.remove("hidden");
      document.getElementById("mensajeBusqueda").innerHTML = `Encontrados: ${usuarios.length} resultado(s)`;
    }

    function limpiarBusqueda() {
      document.getElementById("busquedaInput").value = "";
      document.getElementById("seccionBusqueda").classList.add("hidden");
      document.getElementById("tablaBusqueda").classList.add("hidden");
      document.getElementById("mensajeBusqueda").innerHTML = "";
      const contTarjetas = document.getElementById("tarjetasBusqueda");
      if (contTarjetas) {
        contTarjetas.classList.add("hidden");
        contTarjetas.innerHTML = "";
      }

      const seccionUltimos = document.getElementById("seccionUltimos");
      if (seccionUltimos) seccionUltimos.classList.remove("hidden");
    }

    function abrirModalReporteTransparencia() {
      const modal = document.getElementById("modalReporteTransparencia");
      if (modal) modal.classList.add("show");
    }

    function cerrarModalReporteTransparencia() {
      const modal = document.getElementById("modalReporteTransparencia");
      if (modal) modal.classList.remove("show");
      const form = document.getElementById("formReporteTransparencia");
      if (form) form.reset();
    }

    function mostrarMensaje(texto, tipo) {
      const div = document.createElement("div");
      div.className = `${tipo === 'success' ? 'bg-green-50 border-green-200 text-green-700' : 'bg-red-50 border-red-200 text-red-700'} border rounded-xl px-4 py-3 mb-4 text-sm flex items-center gap-2`;
      div.innerHTML = `<span class="material-symbols-outlined text-base">${tipo === 'success' ? 'check_circle' : 'error'}</span> ${texto}`;
      document.querySelector("main").insertBefore(div, document.querySelector("main").firstChild);
      
      setTimeout(() => div.remove(), 3000);
    }

    // Enter en búsqueda
    document.getElementById("busquedaInput")?.addEventListener("keypress", (e) => {
      if (e.key === "Enter") buscarTrabajadores();
    });

    // Cerrar modal al hacer click fuera
    window.onclick = function(event) {
      const modalTrabajador = document.getElementById("miModal");
      const modalReporte = document.getElementById("modalReporteTransparencia");
      if (event.target == modalTrabajador) {
        cerrarModal();
      }
      if (event.target == modalReporte) {
        cerrarModalReporteTransparencia();
      }
    };
  </script>

</body>
</html>
