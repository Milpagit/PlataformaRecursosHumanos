<!DOCTYPE html>
<html lang="es">
<head>
  <title>Detalles del Trabajador - Poder Judicial Hidalgo</title>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <link href="/css/styles.css" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: "#4a7d59",
            "background-light": "#f6f7f7",
          },
          fontFamily: {
            display: ["Inter"],
          },
          borderRadius: {
            DEFAULT: "0.25rem",
            lg: "0.5rem",
            xl: "0.75rem",
            full: "9999px",
          },
        },
      },
    };
  </script>
  <script>
    function generarAcuse() {
      const noTrabajador = document.getElementById('noTrabajador').value;
      window.open(`/acuse/${noTrabajador}`, '_blank');
    }

    function verCurriculum() {
      const noTrabajador = document.getElementById('noTrabajador').value;
      window.open(`/curriculum/${noTrabajador}`, '_blank');
    }

    function descargarZip() {
      const noTrabajador = document.getElementById('noTrabajador').value;
      window.location.href = `/reporte/${noTrabajador}`;
    }
  </script>
</head>
<body class="bg-background-light font-display text-slate-900 antialiased">
    <!-- ENCABEZADO PRINCIPAL -->
  <header class="w-full bg-verdegris text-white py-6 shadow-md">
    <div class="container mx-auto flex items-center justify-center">
      <img src="/images/pj-logo.png" alt="Logo PJ" class="w-24 h-auto mr-4" />
      <h1 class="text-2xl md:text-3xl font-bold uppercase tracking-wide">
        Detalles del Trabajador 
      </h1>
      <img src="/images/consejo-logo.png" alt="Logo Consejo" class="w-24 h-auto mr-4" />
    
    </div>
  </header>
  <div class="relative flex min-h-screen flex-col">

    <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 md:px-10">

      <% if (error) { %>
        <div class="mb-6 rounded-xl bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm">
          <%= error %>
        </div>
      <% } %>

      <% if (trabajador) { %>
        <input type="hidden" id="idTrabajador" value="<%= trabajador.idTrabajador %>" />
        <input type="hidden" id="noTrabajador" value="<%= trabajador.noTrabajador %>" />

        <!-- Profile Hero Section -->
        <div class="mb-6 rounded-xl bg-white p-6 shadow-sm border border-slate-200">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="space-y-1">
              <div class="flex items-center gap-2 text-primary font-bold text-sm uppercase tracking-wider">
                <span class="material-symbols-outlined text-base">badge</span>
                Expediente del Trabajador
              </div>
              <h2 class="text-2xl font-bold text-slate-900">
                <%= trabajador.nombreTrabajador %>
              </h2>
              <div class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-slate-500">
                <span class="flex items-center gap-1.5"><strong>CURP:</strong> <%= trabajador.curp || 'N/A' %></span>
                <span class="flex items-center gap-1.5"><strong>RFC:</strong> <%= trabajador.rfc || 'N/A' %></span>
                <span class="flex items-center gap-1.5 text-primary font-medium">
                  <span class="material-symbols-outlined text-sm">location_on</span>
                  <%= trabajador.adscripcionActual || 'N/A' %>
                </span>
              </div>
            </div>
            <div class="flex flex-wrap gap-2">
              <button onclick="generarAcuse()" class="flex items-center gap-2 rounded-md bg-slate-100 px-3 py-2 text-xs font-bold text-slate-700 border border-slate-200 hover:bg-slate-200 transition-colors">
                <span class="material-symbols-outlined text-base">document_scanner</span>
                Ver Acuse
              </button>
              <button onclick="verCurriculum()" class="flex items-center gap-2 rounded-md bg-primary px-3 py-2 text-xs font-bold text-white hover:bg-primary/90 transition-colors shadow-sm">
                <span class="material-symbols-outlined text-base">visibility</span>
                Ver CV
              </button>
              <button onclick="descargarZip()" class="flex items-center gap-2 rounded-md bg-white border border-primary/30 px-3 py-2 text-xs font-bold text-primary hover:bg-primary/5 transition-colors">
                <span class="material-symbols-outlined text-base">download</span>
                Descargar Todo
              </button>
            </div>
          </div>
        </div>

        <!-- Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

          <!-- Left Column: Personal & Family -->
          <div class="space-y-8">

            <!-- Datos Personales -->
            <section class="rounded-xl bg-white p-6 shadow-sm border border-slate-200">
              <div class="mb-5 flex items-center gap-2 bg-slate-50/50 -mx-6 -mt-6 px-6 py-4 mb-6 rounded-t-xl">
                <span class="material-symbols-outlined text-primary">person</span>
                <h3 class="font-bold text-lg">Datos Personales</h3>
              </div>
              <div class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                  <div class="col-span-2">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-primary">Correo Electrónico</p>
                    <p class="text-sm font-semibold"><%= trabajador.correoElectronico || 'N/A' %></p>
                  </div>
                  <div>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-primary">Fecha de Ingreso</p>
                    <p class="text-sm font-semibold"><%= trabajador.fechaIngreso ? new Date(trabajador.fechaIngreso).toLocaleDateString('es-MX') : 'N/A' %></p>
                  </div>
                  <div>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-primary">Puesto Actual</p>
                    <p class="text-sm font-semibold"><%= trabajador.cargoActual || 'N/A' %></p>
                  </div>
                  <div class="col-span-2">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-primary">Adscripción</p>
                    <p class="text-sm font-semibold"><%= trabajador.adscripcionActual || 'N/A' %></p>
                  </div>
                </div>
              </div>
            </section>

            <!-- Información Familiar (Hijos) -->
            <section class="rounded-xl bg-white p-6 shadow-sm border border-slate-200">
              <div class="mb-5 flex items-center gap-2 bg-slate-50/50 -mx-6 -mt-6 px-6 py-4 mb-6 rounded-t-xl">
                <span class="material-symbols-outlined text-primary">family_restroom</span>
                <h3 class="font-bold text-lg">Información Familiar</h3>
              </div>
              <div class="space-y-3">
                <p class="text-[10px] font-bold uppercase tracking-widest text-primary mb-3">Hijos Registrados</p>
                <% if (hijos && hijos.length > 0) { %>
                  <div class="border-t border-slate-100">
                    <% hijos.forEach(hijo => { %>
                      <div class="flex items-center justify-between py-2 border-b border-slate-50">
                        <span class="text-sm font-medium"><%= hijo.inicialesHijo %></span>
                        <span class="text-[10px] font-bold px-2 py-0.5 bg-blue-50 text-blue-700 rounded"><%= hijo.sexoHijo %></span>
                      </div>
                    <% }); %>
                  </div>
                <% } else { %>
                  <p class="text-slate-400 text-sm">Sin información</p>
                <% } %>
              </div>
            </section>

          </div>

          <!-- Right Column: Education & Experience -->
          <div class="lg:col-span-2 space-y-8">

            <!-- Escolaridad Timeline -->
            <section class="rounded-xl bg-white p-6 shadow-sm border border-slate-200">
              <div class="mb-6 flex items-center gap-2 bg-slate-50/50 -mx-6 -mt-6 px-6 py-4 mb-6 rounded-t-xl">
                <span class="material-symbols-outlined text-primary">school</span>
                <h3 class="font-bold text-lg">Escolaridad</h3>
              </div>
              <% if (escolaridad && escolaridad.length > 0) { %>
                <div class="relative space-y-8 pl-8 before:absolute before:left-[11px] before:top-2 before:h-[calc(100%-16px)] before:w-0.5 before:bg-slate-200">
                  <% escolaridad.forEach(esc => { %>
                    <div class="relative">
                      <div class="absolute -left-[27px] top-1.5 h-4 w-4 rounded-full border-2 border-primary bg-white"></div>
                      <div class="flex flex-col md:flex-row md:items-center justify-between gap-2">
                        <div>
                          <h4 class="font-bold text-slate-900"><%= esc.nombreTitulo || 'Sin Título' %></h4>
                          <p class="text-sm text-slate-500"><%= esc.institucion || 'Sin Institución' %></p>
                          <% if (esc.fechaObtencion) { %>
                            <p class="text-xs text-slate-400 mt-0.5"><%= new Date(esc.fechaObtencion).toLocaleDateString('es-MX') %></p>
                          <% } %>
                        </div>
                        <span class="inline-flex shrink-0 items-center rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary">
                          <%= esc.nivelAcademico || 'N/A' %>
                        </span>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } else { %>
                <p class="text-slate-400 text-sm">Sin información</p>
              <% } %>
            </section>

            <!-- Experiencia PJ -->
            <section class="rounded-xl bg-white p-6 shadow-sm border border-slate-200">
              <div class="mb-5 flex items-center gap-2 bg-slate-50/50 -mx-6 -mt-6 px-6 py-4 mb-4 rounded-t-xl">
                <span class="material-symbols-outlined text-primary">work_history</span>
                <h3 class="font-bold text-lg">Experiencia en Poder Judicial</h3>
              </div>
              <% if (experienciaPJ && experienciaPJ.length > 0) { %>
                <div class="divide-y divide-slate-100">
                  <% experienciaPJ.forEach(exp => { %>
                    <div class="py-4 first:pt-0 last:pb-0">
                      <div class="flex items-start gap-4">
                        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-slate-50 text-primary">
                          <span class="material-symbols-outlined">work</span>
                        </div>
                        <div>
                          <h4 class="font-bold"><%= exp.cargo || 'N/A' %></h4>
                          <p class="text-sm text-slate-500"><%= exp.adscripcion || 'N/A' %></p>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } else { %>
                <p class="text-slate-400 text-sm">Sin información</p>
              <% } %>
            </section>

          </div>
        </div>

      <% } else { %>
        <div class="text-center py-16">
          <p class="text-2xl text-slate-400">Trabajador no encontrado</p>
          <a href="/admin/dashboard" class="mt-4 inline-block bg-primary hover:bg-primary/90 text-white font-semibold px-6 py-3 rounded-lg transition-colors">
            Volver a dashboard
          </a>
        </div>
      <% } %>

    </main>

    <!-- Footer -->
    <footer class="mt-12 border-t border-slate-200 bg-white py-8 px-4 md:px-10">
      <div class="mx-auto max-w-7xl flex flex-col md:flex-row justify-between items-center gap-4 text-slate-500 text-sm">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-primary">verified</span>
          <span>Poder Judicial del Estado de Hidalgo</span>
        </div>
        <div class="flex gap-6">
          <a class="hover:text-primary transition-colors" href="/admin/dashboard">Dashboard</a>
          <p>&copy; 2026 PJH</p>
        </div>
      </div>
    </footer>

  </div>
</body>
</html>
