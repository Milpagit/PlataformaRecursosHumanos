<!DOCTYPE html>
<html lang="es">
<head>
  <title>Detalles del Trabajador</title>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="/css/styles.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <style>
    .action-btn {
      min-height: 38px;
      border-radius: 0.5rem;
      border: 1px solid transparent;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
      transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
      font-size: 0.875rem;
    }

    .action-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      filter: brightness(0.98);
    }

    .action-btn:active {
      transform: translateY(0);
    }

    .action-btn:focus-visible {
      outline: none;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.28);
    }
  </style>
  <script>
    function generarAcuse() {
      const noTrabajador = document.getElementById('noTrabajador').value;
      // Abrir el mismo acuse HTML que ve el trabajador
      window.open(`/acuse/${noTrabajador}`, '_blank');
    }

    function verCurriculum() {
      const noTrabajador = document.getElementById('noTrabajador').value;
      // Abrir el curriculum en vista previa HTML/PDF
      window.open(`/curriculum/${noTrabajador}`, '_blank');
    }

    function descargarZip() {
      const noTrabajador = document.getElementById('noTrabajador').value;
      // Descargar el ZIP con reporte + documentos del trabajador
      window.location.href = `/reporte/${noTrabajador}`;
    }
  </script>
</head>
<body class="bg-gray-100 font-sans text-grisTexto flex flex-col min-h-screen">

  <!-- ENCABEZADO PRINCIPAL -->
<header class="w-full bg-verdegris text-white py-6 shadow-md">
    <div class="container mx-auto flex items-center justify-center">
      <img src="/images/pj-logo.png" alt="Logo PJ" class="w-24 h-auto mr-4" />
      <h1 class="text-2xl md:text-3xl font-bold uppercase tracking-wide">
        Detalles del Trabajador 
      </h1>
      <img src="/images/consejo-logo.png" alt="Logo Consejo" class="w-24 h-auto mr-4" />
    </div>
  </header>
  <!-- CONTENIDO PRINCIPAL -->
  <main class="flex-grow container mx-auto py-8 px-4">

    <% if (error) { %>
      <div class="max-w-4xl mx-auto bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
        <%= error %>
      </div>
    <% } %>

    <% if (trabajador) { %>
      <input type="hidden" id="idTrabajador" value="<%= trabajador.idTrabajador %>" />
      <input type="hidden" id="noTrabajador" value="<%= trabajador.noTrabajador %>" />

      <div class="max-w-4xl mx-auto">

        <!-- INFORMACIÓN PRINCIPAL -->
        <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
          <div class="flex justify-between items-start mb-6">
            <div>
              <h2 class="text-9xl font-bold text-verdegris"><%= trabajador.nombreTrabajador %></h2>
            </div>
          </div>

          <!-- DATOS PRINCIPALES -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <p class="text-sm text-gray-600">CURP</p>
              <p class="text-xl font-semibold"><%= trabajador.curp || 'N/A' %></p>
            </div>
            <div>
              <p class="text-sm text-gray-600">RFC</p>
              <p class="text-xl font-semibold"><%= trabajador.rfc || 'N/A' %></p>
            </div>
            <div>
              <p class="text-sm text-gray-600">Correo Electrónico</p>
              <p class="text-lg font-semibold"><%= trabajador.correoElectronico || 'N/A' %></p>
            </div>
            <div>
              <p class="text-sm text-gray-600">Puesto Actual</p>
              <p class="text-lg font-semibold"><%= trabajador.cargoActual || 'N/A' %></p>
            </div>
            <div>
              <p class="text-sm text-gray-600">Adscripción</p>
              <p class="text-lg font-semibold"><%= trabajador.adscripcionActual || 'N/A' %></p>
            </div>
            <div>
              <p class="text-sm text-gray-600">Fecha de Ingreso</p>
              <p class="text-lg font-semibold"><%= trabajador.fechaIngreso ? new Date(trabajador.fechaIngreso).toLocaleDateString('es-MX') : 'N/A' %></p>
            </div>
          </div>
        </div>

        <!-- BOTONES DE ACCIONES -->
        <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
          <h3 class="text-xl font-bold text-verdegris mb-4">Acciones</h3>
          <div class="flex flex-nowrap items-center gap-2 overflow-x-auto pb-1">
            <button onclick="generarAcuse()" class="action-btn inline-flex items-center justify-center gap-x-2 bg-verdegris text-white font-semibold px-3 py-2 whitespace-nowrap">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-file-earmark-medical flex-shrink-0" viewBox="0 0 16 16">
                <path d="M7.5 5.5a.5.5 0 0 0-1 0v.634l-.549-.317a.5.5 0 1 0-.5.866L6 7l-.549.317a.5.5 0 1 0 .5.866l.549-.317V8.5a.5.5 0 1 0 1 0v-.634l.549.317a.5.5 0 1 0 .5-.866L8 7l.549-.317a.5.5 0 1 0-.5-.866l-.549.317zm-2 4.5a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1zm0 2a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1z"/>
                <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/>
              </svg>
              
              <span class="leading-none whitespace-nowrap">Generar Acuse</span>
            </button>

            <button onclick="verCurriculum()" class="action-btn inline-flex items-center justify-center gap-x-2 bg-blue-600 text-white font-semibold px-3 py-2 whitespace-nowrap">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-file-earmark-text flex-shrink-0" viewBox="0 0 16 16">
                <path d="M5.5 7a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1zM5 9.5A.5.5 0 0 1 5.5 9h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m0 2A.5.5 0 0 1 5.5 11h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5"/>
                <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5z"/>
              </svg>
              <span class="leading-none whitespace-nowrap">Ver Curriculum</span>
            </button>

            <button onclick="descargarZip()" class="action-btn inline-flex items-center justify-center gap-x-2 bg-amarilloPJ text-grisTexto font-semibold px-3 py-2 whitespace-nowrap border border-[#e2c77f]">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-file-earmark-zip flex-shrink-0" viewBox="0 0 16 16">
                <path d="M6.5 7.5V8h1v-.5z"/>
                <path d="M6 8.5V9h1v-.5z"/>
                <path d="M6.5 9.5V10h1v-.5z"/>
                <path d="M9.293 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.707a1 1 0 0 0-.293-.707L10 0.293A1 1 0 0 0 9.293 0M9.5 3a1.5 1.5 0 0 0 1.5 1.5H13V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/>
                <path d="M6 5h1v1H6zM7 6h1v1H7zM6 7h1v1H6zM7 8h1v1H7zM6 9h1v1H6z"/>
              </svg>

              <span class="leading-none whitespace-nowrap">Descargar ZIP</span>
            </button>
          </div>
        </div>

        <!-- INFORMACIÓN ADICIONAL -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">

          <!-- HIJOS -->
          <div class="bg-white rounded-lg shadow-lg p-6">
            <h1 class="text-3xl font-bold text-verdegris mb-4">Información Adicional</h1>

            <h3 class="text-lg font-bold text-verdegris mb-4">Hijos</h3>
            <% if (hijos && hijos.length > 0) { %>
              <ul class="space-y-2">
                <% hijos.forEach(hijo => { %>
                  <li class="text-sm border-b pb-2">
                    <strong><%= hijo.inicialesHijo %>.</strong> - <%= hijo.sexoHijo %>
                  </li>
                <% }); %>
              </ul>
            <% } else { %>
              <p class="text-gray-500 text-sm">Sin información</p>
            <% } %>
          </div>

          <!-- ESCOLARIDAD -->
          <div class="bg-white rounded-lg shadow-lg p-6">
            <h3 class="text-lg font-bold text-verdegris mb-4">Escolaridad</h3>
            <% if (escolaridad && escolaridad.length > 0) { %>
              <ul class="space-y-3">
                <% escolaridad.forEach(esc => { %>
                  <li class="text-sm border-b pb-2">
                    <div class="font-semibold text-verdegris"><%= esc.nivelAcademico || 'N/A' %></div>
                    <div class="text-gray-700"><%= esc.nombreTitulo || 'Sin Título' %></div>
                    <% if (esc.institucion) { %>
                      <div class="text-gray-600 text-xs"><%= esc.institucion %></div>
                    <% } %>
                    <% if (esc.fechaObtencion) { %>
                      <div class="text-gray-500 text-xs"><%= new Date(esc.fechaObtencion).toLocaleDateString('es-MX') %></div>
                    <% } %>
                  </li>
                <% }); %>
              </ul>
            <% } else { %>
              <p class="text-gray-500 text-sm">Sin información</p>
            <% } %>
          </div>

          <!-- EXPERIENCIA EN PJ -->
          <div class="bg-white rounded-lg shadow-lg p-6">
            <h3 class="text-lg font-bold text-verdegris mb-4">Experiencia PJ</h3>
            <% if (experienciaPJ && experienciaPJ.length > 0) { %>
              <ul class="space-y-2">
                <% experienciaPJ.forEach(exp => { %>
                  <li class="text-sm border-b pb-2">
                    <strong><%= exp.cargo || 'N/A' %></strong>
                    <br/>
                    <span class="text-gray-600"><%= exp.adscripcion || 'N/A' %></span>
                  </li>
                <% }); %>
              </ul>
            <% } else { %>
              <p class="text-gray-500 text-sm">Sin información</p>
            <% } %>
          </div>

        </div>

      </div>

    <% } else { %>
      <div class="max-w-4xl mx-auto text-center py-16">
        <p class="text-2xl text-gray-500">Trabajador no encontrado</p>
        <a href="/admin/dashboard" class="mt-4 inline-block bg-verdegris hover:bg-[#0b6451] text-white font-semibold px-6 py-3 rounded">
          Volver a dashboard
        </a>
      </div>
    <% } %>

  </main>

</body>
</html>
