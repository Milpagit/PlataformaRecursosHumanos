<!DOCTYPE html>
<html lang="es">
<head>
  <title>Detalles del Trabajador - Poder Judicial Hidalgo</title>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <link href="/css/styles.css" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: "#4a7d59",
            "background-light": "#f6f7f7",
          },
          fontFamily: {
            display: ["Inter"],
          },
          borderRadius: {
            DEFAULT: "0.25rem",
            lg: "0.5rem",
            xl: "0.75rem",
            full: "9999px",
          },
        },
      },
    };
  </script>
  <script>
    function generarAcuse() {
      const noTrabajador = document.getElementById('noTrabajador').value;
      const tipoTrabajador = document.getElementById('tipoTrabajador').value;
      window.open(`/acuse/${noTrabajador}/${tipoTrabajador}`, '_blank');
    }

    function verCurriculum() {
      const noTrabajador = document.getElementById('noTrabajador').value;
      const tipoTrabajador = document.getElementById('tipoTrabajador').value;
      window.open(`/curriculum/${noTrabajador}/${tipoTrabajador}`, '_blank');
    }

    function descargarZip() {
      const noTrabajador = document.getElementById('noTrabajador').value;
      const tipoTrabajador = document.getElementById('tipoTrabajador').value;
      window.location.href = `/reporte/${noTrabajador}/${tipoTrabajador}`;
    }

    function toggleEdicion() {
      const panel = document.getElementById('panelEdicion');
      const icono = document.getElementById('iconoEdicion');
      panel.classList.toggle('hidden');
      icono.textContent = panel.classList.contains('hidden') ? 'expand_more' : 'expand_less';
    }

    function mostrarMensajeEdicion(texto, tipo) {
      const el = document.getElementById('mensajeEdicion');
      el.textContent = texto;
      el.className = `text-sm rounded-lg px-3 py-2 ${tipo === 'error' ? 'bg-red-50 border border-red-200 text-red-700' : 'bg-green-50 border border-green-200 text-green-700'}`;
      el.classList.remove('hidden');
    }

    async function guardarDatosCriticos() {
      const idTrabajador = document.getElementById('idTrabajador').value;
      const nuevoNoTrabajador = document.getElementById('nuevoNoTrabajador').value.trim();
      const nuevoTipo = document.querySelector('input[name="nuevoTipo"]:checked')?.value;
      const password = document.getElementById('passwordConfirmacion').value;

      if (!nuevoNoTrabajador || !nuevoTipo) {
        mostrarMensajeEdicion('Completa el número y tipo de trabajador.', 'error');
        return;
      }
      if (!password) {
        mostrarMensajeEdicion('Ingresa tu contraseña de administrador para confirmar.', 'error');
        return;
      }

      try {
        const res = await fetch('/admin/editar-datos-criticos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ idTrabajador, nuevoNoTrabajador, nuevoTipo, password }),
        });
        const data = await res.json();
        if (data.success) {
          mostrarMensajeEdicion(data.mensaje, 'success');
          document.getElementById('noTrabajador').value = nuevoNoTrabajador;
          document.getElementById('tipoTrabajador').value = nuevoTipo;
          setTimeout(() => location.reload(), 1500);
        } else {
          mostrarMensajeEdicion(data.error, 'error');
        }
      } catch (e) {
        mostrarMensajeEdicion('Error de conexión. Intenta de nuevo.', 'error');
      }
    }

    async function confirmarEliminar() {
      const password = document.getElementById('passwordConfirmacion').value;
      if (!password) {
        mostrarMensajeEdicion('Ingresa tu contraseña de administrador para confirmar la eliminación.', 'error');
        return;
      }
      if (!confirm('¿Estás seguro de eliminar este trabajador? Esta acción no se puede deshacer.')) return;

      const idTrabajador = document.getElementById('idTrabajador').value;
      try {
        const res = await fetch('/admin/eliminar-trabajador', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ idTrabajador, password }),
        });
        const data = await res.json();
        if (data.success) {
          mostrarMensajeEdicion(data.mensaje, 'success');
          setTimeout(() => window.location.href = '/admin/dashboard', 1500);
        } else {
          mostrarMensajeEdicion(data.error, 'error');
        }
      } catch (e) {
        mostrarMensajeEdicion('Error de conexión. Intenta de nuevo.', 'error');
      }
    }
  </script>
</head>
<body class="bg-background-light font-display text-slate-900 antialiased">
    <!-- ENCABEZADO PRINCIPAL -->
  <header class="w-full bg-verdegris text-white py-6 shadow-md">
    <div class="container mx-auto flex items-center justify-center">
      <img src="/images/pj-logo.png" alt="Logo PJ" class="w-24 h-auto mr-4" />
      <h1 class="text-2xl md:text-3xl font-bold uppercase tracking-wide">
        Detalles del Trabajador 
      </h1>
      <img src="/images/consejo-logo.png" alt="Logo Consejo" class="w-24 h-auto mr-4" />
    
    </div>
  </header>
  <div class="relative flex min-h-screen flex-col">

    <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 md:px-10">

      <% if (error) { %>
        <div class="mb-6 rounded-xl bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm">
          <%= error %>
        </div>
      <% } %>

      <% if (trabajador) { %>
        <input type="hidden" id="idTrabajador" value="<%= trabajador.idTrabajador %>" />
        <input type="hidden" id="noTrabajador" value="<%= trabajador.noTrabajador %>" />
        <input type="hidden" id="tipoTrabajador" value="<%= trabajador.tipoTrabajador || '' %>" />

        <!-- Profile Hero Section -->
        <div class="mb-6 rounded-xl bg-white p-6 shadow-sm border border-slate-200">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="space-y-1">
              <div class="flex items-center gap-2 text-primary font-bold text-sm uppercase tracking-wider">
                <span class="material-symbols-outlined text-base">badge</span>
                Expediente del Trabajador
              </div>
              <h2 class="text-2xl font-bold text-slate-900">
                <%= trabajador.nombreTrabajador %>
              </h2>
              <div class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-slate-500">
                <span class="flex items-center gap-1.5"><strong>CURP:</strong> <%= trabajador.curp || 'N/A' %></span>
                <span class="flex items-center gap-1.5"><strong>RFC:</strong> <%= trabajador.rfc || 'N/A' %></span>
                <span class="flex items-center gap-1.5">
                  <strong>Contraseña:</strong>
                  <span class="font-mono font-semibold text-primary"><%= trabajador.password || 'N/A' %></span>
                </span>
                <span class="flex items-center gap-1.5">
                  <strong>No. Trabajador:</strong>
                  <span class="font-bold text-primary"><%= trabajador.noTrabajador || 'N/A' %></span>
                </span>
                <span class="flex items-center gap-1.5">
                  <strong>Tipo:</strong>
                  <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-bold
                    <%= trabajador.tipoTrabajador === 'C' ? 'bg-blue-50 text-blue-700' : trabajador.tipoTrabajador === 'H' ? 'bg-amber-50 text-amber-700' : 'bg-slate-100 text-slate-500' %>">
                    <%= trabajador.tipoTrabajador === 'C' ? 'Confianza' : trabajador.tipoTrabajador === 'H' ? 'Honorario' : 'N/A' %>
                  </span>
                </span>
                <span class="flex items-center gap-1.5 text-primary font-medium">
                  <span class="material-symbols-outlined text-sm">location_on</span>
                  <%= trabajador.adscripcionActual || 'N/A' %>
                </span>
              </div>
            </div>
            <div class="flex flex-wrap gap-2">
              <button onclick="generarAcuse()" class="flex items-center gap-2 rounded-md bg-slate-100 px-3 py-2 text-xs font-bold text-slate-700 border border-slate-200 hover:bg-slate-200 transition-colors">
                <span class="material-symbols-outlined text-base">document_scanner</span>
                Ver Acuse
              </button>
              <button onclick="verCurriculum()" class="flex items-center gap-2 rounded-md bg-primary px-3 py-2 text-xs font-bold text-white hover:bg-primary/90 transition-colors shadow-sm">
                <span class="material-symbols-outlined text-base">visibility</span>
                Ver CV
              </button>
              <button onclick="descargarZip()" class="flex items-center gap-2 rounded-md bg-white border border-primary/30 px-3 py-2 text-xs font-bold text-primary hover:bg-primary/5 transition-colors">
                <span class="material-symbols-outlined text-base">download</span>
                Descargar Todo
              </button>
            </div>
          </div>
        </div>

        <!-- Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

          <!-- Left Column: Personal & Family -->
          <div class="space-y-8">

            <!-- Datos Personales -->
            <section class="rounded-xl bg-white p-6 shadow-sm border border-slate-200">
              <div class="mb-5 flex items-center gap-2 bg-slate-50/50 -mx-6 -mt-6 px-6 py-4 mb-6 rounded-t-xl">
                <span class="material-symbols-outlined text-primary">person</span>
                <h3 class="font-bold text-lg">Datos Personales</h3>
              </div>
              <div class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                  <div class="col-span-2">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-primary">Correo Electrónico</p>
                    <p class="text-sm font-semibold"><%= trabajador.correoElectronico || 'N/A' %></p>
                  </div>
                  <div class="col-span-2">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-primary">Contraseña</p>
                    <p class="text-sm font-semibold"><%= trabajador.password || 'N/A' %></p>
                  </div>
                  <div>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-primary">Fecha de Ingreso</p>
                    <p class="text-sm font-semibold"><%= trabajador.fechaIngreso ? new Date(trabajador.fechaIngreso).toLocaleDateString('es-MX') : 'N/A' %></p>
                  </div>
                  <div>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-primary">Puesto Actual</p>
                    <p class="text-sm font-semibold"><%= trabajador.cargoActual || 'N/A' %></p>
                  </div>
                  <div class="col-span-2">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-primary">Adscripción</p>
                    <p class="text-sm font-semibold"><%= trabajador.adscripcionActual || 'N/A' %></p>
                  </div>
                </div>
              </div>
            </section>

            <!-- Información Familiar (Hijos) -->
            <section class="rounded-xl bg-white p-6 shadow-sm border border-slate-200">
              <div class="mb-5 flex items-center gap-2 bg-slate-50/50 -mx-6 -mt-6 px-6 py-4 mb-6 rounded-t-xl">
                <span class="material-symbols-outlined text-primary">family_restroom</span>
                <h3 class="font-bold text-lg">Información Familiar</h3>
              </div>
              <div class="space-y-3">
                <p class="text-[10px] font-bold uppercase tracking-widest text-primary mb-3">Hijos Registrados</p>
                <% if (hijos && hijos.length > 0) { %>
                  <div class="border-t border-slate-100">
                    <% hijos.forEach(hijo => { %>
                      <div class="flex items-center justify-between py-2 border-b border-slate-50">
                        <span class="text-sm font-medium"><%= hijo.inicialesHijo %></span>
                        <span class="text-[10px] font-bold px-2 py-0.5 bg-blue-50 text-blue-700 rounded"><%= hijo.sexoHijo %></span>
                      </div>
                    <% }); %>
                  </div>
                <% } else { %>
                  <p class="text-slate-400 text-sm">Sin información</p>
                <% } %>
              </div>
            </section>

            <!-- Edición de Datos Críticos -->
            <section class="rounded-xl bg-white shadow-sm border border-red-200" id="seccionDatosCriticos">
              <button type="button" onclick="toggleEdicion()"
                class="w-full flex items-center justify-between px-6 py-4 rounded-xl hover:bg-red-50 transition-colors">
                <div class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-red-600">admin_panel_settings</span>
                  <span class="font-bold text-red-700 text-sm uppercase tracking-widest">Edición de Datos Críticos</span>
                </div>
                <span class="material-symbols-outlined text-red-400" id="iconoEdicion">expand_more</span>
              </button>

              <div id="panelEdicion" class="hidden px-6 pb-6 space-y-4">
                <p class="text-xs text-slate-500 bg-amber-50 border border-amber-200 rounded-lg p-3">
                  Modifica el número y tipo de trabajador, o elimina el registro. <strong>Se requiere tu contraseña de administrador para confirmar.</strong>
                </p>

                <!-- No. Trabajador -->
                <div>
                  <label class="block mb-1.5 text-[10px] font-bold uppercase tracking-widest text-slate-600">Nuevo Número de Trabajador</label>
                  <input type="number" id="nuevoNoTrabajador" value="<%= trabajador.noTrabajador %>"
                    class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
                </div>

                <!-- Tipo de Trabajador -->
                <div>
                  <label class="block mb-1.5 text-[10px] font-bold uppercase tracking-widest text-slate-600">Tipo de Trabajador</label>
                  <div class="flex gap-6 mt-1">
                    <label class="flex items-center gap-2 cursor-pointer text-sm font-medium">
                      <input type="radio" name="nuevoTipo" value="C" style="accent-color:#738F81;" class="w-4 h-4"
                        <%= trabajador.tipoTrabajador === 'C' ? 'checked' : '' %>>
                      Confianza
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer text-sm font-medium">
                      <input type="radio" name="nuevoTipo" value="H" style="accent-color:#738F81;" class="w-4 h-4"
                        <%= trabajador.tipoTrabajador === 'H' ? 'checked' : '' %>>
                      Honorario
                    </label>
                  </div>
                </div>

                <!-- Contraseña de confirmación -->
                <div>
                  <label class="block mb-1.5 text-[10px] font-bold uppercase tracking-widest text-slate-600">Contraseña de Administrador</label>
                  <input type="password" id="passwordConfirmacion" placeholder="Tu contraseña actual"
                    class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
                </div>

                <!-- Mensaje de error/éxito -->
                <div id="mensajeEdicion" class="hidden text-sm rounded-lg px-3 py-2"></div>

                <!-- Botones -->
                <div class="flex gap-3 pt-2">
                  <button type="button" onclick="guardarDatosCriticos()"
                    class="flex-1 flex items-center justify-center gap-2 bg-primary hover:bg-primary/90 text-white font-bold py-2.5 rounded-lg transition-colors text-sm shadow-sm">
                    <span class="material-symbols-outlined text-sm">save</span>
                    Guardar Cambios
                  </button>
                  <button type="button" onclick="confirmarEliminar()"
                    class="flex items-center justify-center gap-2 bg-red-600 hover:bg-red-700 text-white font-bold py-2.5 px-4 rounded-lg transition-colors text-sm shadow-sm">
                    <span class="material-symbols-outlined text-sm">delete</span>
                    Eliminar
                  </button>
                </div>
              </div>
            </section>

          </div>

          <!-- Right Column: Education & Experience -->
          <div class="lg:col-span-2 space-y-8">

            <!-- Escolaridad Timeline -->
            <section class="rounded-xl bg-white p-6 shadow-sm border border-slate-200">
              <div class="mb-6 flex items-center gap-2 bg-slate-50/50 -mx-6 -mt-6 px-6 py-4 mb-6 rounded-t-xl">
                <span class="material-symbols-outlined text-primary">school</span>
                <h3 class="font-bold text-lg">Escolaridad</h3>
              </div>
              <% if (escolaridad && escolaridad.length > 0) { %>
                <div class="relative space-y-8 pl-8 before:absolute before:left-[11px] before:top-2 before:h-[calc(100%-16px)] before:w-0.5 before:bg-slate-200">
                  <% escolaridad.forEach(esc => { %>
                    <div class="relative">
                      <div class="absolute -left-[27px] top-1.5 h-4 w-4 rounded-full border-2 border-primary bg-white"></div>
                      <div class="flex flex-col md:flex-row md:items-center justify-between gap-2">
                        <div>
                          <h4 class="font-bold text-slate-900"><%= esc.nombreTitulo || 'Sin Título' %></h4>
                          <p class="text-sm text-slate-500"><%= esc.institucion || 'Sin Institución' %></p>
                          <% if (esc.fechaObtencion) { %>
                            <p class="text-xs text-slate-400 mt-0.5"><%= new Date(esc.fechaObtencion).toLocaleDateString('es-MX') %></p>
                          <% } %>
                        </div>
                        <span class="inline-flex shrink-0 items-center rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary">
                          <%= esc.nivelAcademico || 'N/A' %>
                        </span>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } else { %>
                <p class="text-slate-400 text-sm">Sin información</p>
              <% } %>
            </section>

            <!-- Experiencia PJ -->
            <section class="rounded-xl bg-white p-6 shadow-sm border border-slate-200">
              <div class="mb-5 flex items-center gap-2 bg-slate-50/50 -mx-6 -mt-6 px-6 py-4 mb-4 rounded-t-xl">
                <span class="material-symbols-outlined text-primary">work_history</span>
                <h3 class="font-bold text-lg">Experiencia en Poder Judicial</h3>
              </div>
              <% if (experienciaPJ && experienciaPJ.length > 0) { %>
                <div class="divide-y divide-slate-100">
                  <% experienciaPJ.forEach(exp => { %>
                    <div class="py-4 first:pt-0 last:pb-0">
                      <div class="flex items-start gap-4">
                        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-slate-50 text-primary">
                          <span class="material-symbols-outlined">work</span>
                        </div>
                        <div>
                          <h4 class="font-bold"><%= exp.cargo || 'N/A' %></h4>
                          <p class="text-sm text-slate-500"><%= exp.adscripcion || 'N/A' %></p>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } else { %>
                <p class="text-slate-400 text-sm">Sin información</p>
              <% } %>
            </section>

          </div>
        </div>

      <% } else { %>
        <div class="text-center py-16">
          <p class="text-2xl text-slate-400">Trabajador no encontrado</p>
          <a href="/admin/dashboard" class="mt-4 inline-block bg-primary hover:bg-primary/90 text-white font-semibold px-6 py-3 rounded-lg transition-colors">
            Volver a dashboard
          </a>
        </div>
      <% } %>

    </main>

    <!-- Footer -->
    <footer class="mt-12 border-t border-slate-200 bg-white py-8 px-4 md:px-10">
      <div class="mx-auto max-w-7xl flex flex-col md:flex-row justify-between items-center gap-4 text-slate-500 text-sm">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-primary">verified</span>
          <span>Poder Judicial del Estado de Hidalgo</span>
        </div>
        <div class="flex gap-6">
          <a class="hover:text-primary transition-colors" href="/admin/dashboard">Dashboard</a>
          <p>&copy; 2026 PJH</p>
        </div>
      </div>
    </footer>

  </div>
</body>
</html>
