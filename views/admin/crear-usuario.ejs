<!DOCTYPE html>
<html lang="es">
<head>
  <title>Crear Nuevo Trabajador</title>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="/css/styles.css" rel="stylesheet" />
</head>
<body class="bg-gray-100 font-sans text-grisTexto flex flex-col min-h-screen">

  <!-- ENCABEZADO PRINCIPAL -->
  <header class="w-full bg-verdegris text-white py-6 shadow-md">
    <div class="container mx-auto flex items-center justify-between">
      <div class="flex items-center">
        <img src="/images/pj-logo.png" alt="Logo PJ" class="w-20 h-auto mr-4" />
        <h1 class="text-2xl font-bold uppercase">Crear Nuevo Trabajador</h1>
      </div>
      <a href="/admin/dashboard" class="bg-white text-verdegris px-4 py-2 rounded font-semibold hover:bg-gray-100">
        ← Volver
      </a>
    </div>
  </header>

  <!-- CONTENIDO PRINCIPAL -->
  <main class="flex-grow container mx-auto py-8 px-4">

    <div class="max-w-2xl mx-auto">

      <% if (error) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
          <%= error %>
        </div>
      <% } %>

      <% if (mensaje) { %>
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
          <%= mensaje %>
        </div>
      <% } %>

      <form action="/admin/crear-usuario" method="POST" class="bg-white rounded-lg shadow-lg p-8 space-y-6">

        <h2 class="text-2xl font-bold text-verdegris mb-6">Datos del Nuevo Trabajador</h2>

        <!-- NOMBRE -->
        <div>
          <label class="block mb-2 text-sm font-medium">Nombre Completo:</label>
          <input type="text" name="nombre" placeholder="Nombre completo del trabajador" required
                 class="w-full px-4 py-3 border border-gray-300 rounded-md bg-gray-50 focus:outline-none focus:ring-2 focus:ring-verdegris">
        </div>

        <!-- CURP -->
        <div>
          <label class="block mb-2 text-sm font-medium">CURP:</label>
          <input type="text" name="curp" placeholder="CURP (18 caracteres)" required
                 maxlength="18"
                 class="w-full px-4 py-3 border border-gray-300 rounded-md bg-gray-50 focus:outline-none focus:ring-2 focus:ring-verdegris uppercase">
          <p class="text-xs text-gray-500 mt-1">Formato: XXXXXXXXXXXXXX (18 caracteres)</p>
        </div>

        <!-- RFC -->
        <div>
          <label class="block mb-2 text-sm font-medium">RFC:</label>
          <input type="text" name="rfc" placeholder="RFC" required
                 class="w-full px-4 py-3 border border-gray-300 rounded-md bg-gray-50 focus:outline-none focus:ring-2 focus:ring-verdegris uppercase">
        </div>

        <!-- CLAVE TRABAJADOR -->
        <div>
          <label class="block mb-2 text-sm font-medium">Clave de Trabajador:</label>
          <input type="text" name="claveTrabjador" placeholder="Clave asignada al trabajador" required
                 class="w-full px-4 py-3 border border-gray-300 rounded-md bg-gray-50 focus:outline-none focus:ring-2 focus:ring-verdegris">
          <p class="text-xs text-gray-500 mt-1">Este es el noTrabajador</p>
        </div>

        <!-- BOTONES -->
        <div class="flex space-x-4 pt-4">
          <button type="submit" class="flex-1 bg-amarilloPJ hover:bg-[#e1c27d] text-grisTexto font-semibold py-3 rounded-md transition">
            Crear Trabajador
          </button>
          <a href="/admin/dashboard" class="flex-1 text-center bg-gray-300 hover:bg-gray-400 text-grisTexto font-semibold py-3 rounded-md transition">
            Cancelar
          </a>
        </div>

      </form>

      <!-- NOTAS -->
      <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
        <h3 class="font-bold text-blue-900 mb-2">Notas importantes:</h3>
        <ul class="text-sm text-blue-800 space-y-1">
          <li>• Este formulario solo requiere los datos básicos iniciales</li>
          <li>• El CURP debe tener exactamente 18 caracteres</li>
          <li>• El trabajador podrá completar el resto de sus datos después de iniciar sesión</li>
        </ul>
      </div>

    </div>

  </main>

</body>
</html>
